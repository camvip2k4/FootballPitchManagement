@model FootballPitchManagement.Models.ViewModels.RecordPaymentVM

@{
    ViewData["Title"] = "Lập Phiếu Thu Tiền Tại Quầy";
}

<div class="row justify-content-center">
    <div class="col-lg-6 col-md-8">
        <div class="card shadow border-0 rounded-4 overflow-hidden">
            <div class="card-header bg-warning text-dark py-3 px-4">
                <h4 class="mb-0 fw-bold d-flex align-items-center">
                    <i class="bi bi-cash-stack me-2"></i> Lập Phiếu Thu Tiền Tại Quầy
                </h4>
            </div>
            <div class="card-body p-4">
                <div class="alert alert-light border rounded-3 mb-4">
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Mã đơn đặt:</span>
                        <strong class="text-primary fs-6">@Model.BookingCode</strong>
                    </div>
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="text-muted">Số tiền còn thiếu:</span>
                        <strong class="text-danger fs-4">@Model.BalanceDue.ToString("N0") đ</strong>
                    </div>
                </div>

                <form asp-action="RecordPayment" method="post">
                    <input type="hidden" asp-for="BookingId" />
                    <input type="hidden" asp-for="BookingCode" />

                    <div class="mb-3">
                        <label asp-for="Amount" class="form-label fw-bold">Số Tiền Thu Thực Tế (VND):</label>
                        <input asp-for="Amount" class="form-control form-control-lg fw-bold text-success" />
                        <span asp-validation-for="Amount" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Method" class="form-label fw-bold">Phương Thức Nhận Tiền:</label>
                        <select asp-for="Method" class="form-select form-select-lg">
                            <option value="CASH">Tiền mặt tại quầy lễ tân</option>
                            <option value="BANK_TRANSFER">Chuyển khoản VietQR ngân hàng</option>
                        </select>
                    </div>

                    <div class="mb-4">
                        <label asp-for="ReceiptRef" class="form-label">Mã Giao Dịch / Ghi Chú Phiếu Thu:</label>
                        <input asp-for="ReceiptRef" class="form-control" placeholder="Mã phiếu thu hoặc ghi chú của nhân viên" />
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-warning btn-lg fw-bold py-2 shadow-sm text-dark">
                            <i class="bi bi-check-lg me-1"></i> Xác Nhận Đã Thu Tiền
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary py-2">Quay lại danh sách</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
