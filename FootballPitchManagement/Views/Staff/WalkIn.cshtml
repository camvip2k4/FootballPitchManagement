@model FootballPitchManagement.Models.ViewModels.WalkInBookingVM

@{
    ViewData["Title"] = "Create Walk-in Booking (UC37)";
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-success text-white py-3">
                <h4 class="mb-0"><i class="bi bi-person-plus"></i> Front Desk Walk-In Booking (UC37)</h4>
            </div>
            <div class="card-body p-4">
                <form asp-action="WalkIn" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="FieldId" class="form-label fw-bold">Select Pitch</label>
                            <select asp-for="FieldId" asp-items="ViewBag.Fields" class="form-select">
                                <option value="">-- Choose Football Field --</option>
                            </select>
                            <span asp-validation-for="FieldId" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="SlotId" class="form-label fw-bold">Time Slot</label>
                            <select asp-for="SlotId" asp-items="ViewBag.Slots" class="form-select">
                                <option value="">-- Choose Time Slot --</option>
                            </select>
                            <span asp-validation-for="SlotId" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="BookingDate" class="form-label fw-bold">Booking Date</label>
                        <input asp-for="BookingDate" class="form-control" type="date" min="@DateTime.Today.ToString("yyyy-MM-dd")" />
                        <span asp-validation-for="BookingDate" class="text-danger"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="GuestName" class="form-label fw-bold">Customer / Guest Name</label>
                            <input asp-for="GuestName" class="form-control" placeholder="Nguyen Van B" />
                            <span asp-validation-for="GuestName" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="GuestPhone" class="form-label fw-bold">Customer Phone Number</label>
                            <input asp-for="GuestPhone" class="form-control" placeholder="0987112233" />
                            <span asp-validation-for="GuestPhone" class="text-danger"></span>
                        </div>
                    </div>

                    <hr />
                    <h5 class="fw-bold text-primary mb-3">Immediate Direct Payment (Optional):</h5>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="DirectPaymentAmount" class="form-label fw-bold">Collected Amount (VND)</label>
                            <input asp-for="DirectPaymentAmount" class="form-control" placeholder="e.g. 150000 or full price" />
                            <small class="text-muted">If payment >= deposit, booking is immediately Confirmed.</small>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="PaymentMethod" class="form-label fw-bold">Payment Method</label>
                            <select asp-for="PaymentMethod" class="form-select">
                                <option value="CASH">Cash at Counter</option>
                                <option value="BANK_TRANSFER">Bank Transfer (QR)</option>
                            </select>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="ReceiptRef" class="form-label">Receipt / Transfer Reference</label>
                        <input asp-for="ReceiptRef" class="form-control" placeholder="Optional receipt or bill code" />
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-success btn-lg fw-semibold py-3">
                            <i class="bi bi-check-circle"></i> Create Counter Booking
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

