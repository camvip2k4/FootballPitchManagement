@model FootballPitchManagement.Models.ViewModels.WalkInBookingVM

@{
    ViewData["Title"] = "Đặt Sân Khách Vãng Lai Tại Quầy";
}

<div class="row justify-content-center">
    <div class="col-lg-7 col-md-9">
        <div class="card shadow border-0 rounded-4 overflow-hidden">
            <div class="card-header bg-success text-white py-3 px-4">
                <h4 class="mb-0 fw-bold d-flex align-items-center">
                    <i class="bi bi-person-plus-fill me-2"></i> Tiếp Nhận Đặt Sân Tại Quầy & Điện Thoại
                </h4>
            </div>
            <div class="card-body p-4">
                <form asp-action="WalkIn" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="FieldId" class="form-label fw-bold">Chọn Sân Thi Đấu</label>
                            <select asp-for="FieldId" asp-items="ViewBag.Fields" class="form-select form-select-lg">
                                <option value="">-- Chọn Sân Bóng --</option>
                            </select>
                            <span asp-validation-for="FieldId" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="SlotId" class="form-label fw-bold">Chọn Khung Giờ (Ca Đá)</label>
                            <select asp-for="SlotId" asp-items="ViewBag.Slots" class="form-select form-select-lg">
                                <option value="">-- Chọn Khung Giờ --</option>
                            </select>
                            <span asp-validation-for="SlotId" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="BookingDate" class="form-label fw-bold">Ngày Thi Đấu</label>
                        <input asp-for="BookingDate" class="form-control" type="date" min="@DateTime.Today.ToString("yyyy-MM-dd")" />
                        <span asp-validation-for="BookingDate" class="text-danger"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="GuestName" class="form-label fw-bold">Tên Khách Hàng / Đội Bóng</label>
                            <input asp-for="GuestName" class="form-control" placeholder="Ví dụ: FC Anh Em, Anh Tuấn..." />
                            <span asp-validation-for="GuestName" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="GuestPhone" class="form-label fw-bold">Số Điện Thoại Liên Hệ</label>
                            <input asp-for="GuestPhone" class="form-control" placeholder="0987112233" />
                            <span asp-validation-for="GuestPhone" class="text-danger"></span>
                        </div>
                    </div>

                    <hr class="my-4" />
                    <h5 class="fw-bold text-dark mb-3"><i class="bi bi-cash-stack text-success me-1"></i> Thu Tiền Trực Tiếp Tại Quầy:</h5>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="DirectPaymentAmount" class="form-label fw-bold">Số Tiền Thu Ngay (VND)</label>
                            <input asp-for="DirectPaymentAmount" class="form-control fw-bold text-success" placeholder="Nhập số tiền thu cọc hoặc thu đủ" />
                            <small class="text-muted">Nếu thu >= tiền cọc (30%), đơn sẽ tự động chuyển sang ĐÃ XÁC NHẬN.</small>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="PaymentMethod" class="form-label fw-bold">Hình Thức Thu Tiền</label>
                            <select asp-for="PaymentMethod" class="form-select">
                                <option value="CASH">Tiền mặt tại quầy</option>
                                <option value="BANK_TRANSFER">Chuyển khoản VietQR</option>
                            </select>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="ReceiptRef" class="form-label">Ghi Chú Phiếu Thu / Mã Hóa Đơn</label>
                        <input asp-for="ReceiptRef" class="form-control" placeholder="Mã phiếu thu hoặc ghi chú của lễ tân" />
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-success btn-lg fw-bold py-3 shadow-sm">
                            <i class="bi bi-check-circle me-1"></i> Tạo Đơn Đặt Sân Tại Quầy
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary py-2">Quay lại bàn điều độ</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
