@model FootballPitchManagement.Models.ViewModels.CheckOutVM

@{
    ViewData["Title"] = "Customer Check-Out (UC20)";
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-primary text-white py-3">
                <h4 class="mb-0"><i class="bi bi-box-arrow-right"></i> Customer Check-Out & Settlement (UC20)</h4>
            </div>
            <div class="card-body p-4">
                <div class="card bg-light border-0 mb-4">
                    <div class="card-body">
                        <div class="row mb-2">
                            <div class="col-sm-4 text-muted">Booking Code:</div>
                            <div class="col-sm-8 fw-bold">@Model.BookingCode</div>
                        </div>
                        <div class="row mb-2">
                            <div class="col-sm-4 text-muted">Pitch:</div>
                            <div class="col-sm-8 fw-bold">@Model.FieldName</div>
                        </div>
                        <div class="row mb-2">
                            <div class="col-sm-4 text-muted">Customer:</div>
                            <div class="col-sm-8">@Model.CustomerInfo</div>
                        </div>
                        <div class="row mb-2">
                            <div class="col-sm-4 text-muted">Total Price:</div>
                            <div class="col-sm-8">@Model.AgreedPrice.ToString("N0") VND</div>
                        </div>
                        <div class="row mb-2">
                            <div class="col-sm-4 text-muted">Amount Paid:</div>
                            <div class="col-sm-8 text-success fw-bold">@Model.PaidAmount.ToString("N0") VND</div>
                        </div>
                        <div class="row">
                            <div class="col-sm-4 text-muted">Remaining Balance Due:</div>
                            <div class="col-sm-8 fs-5 fw-bold text-danger">@Model.BalanceDue.ToString("N0") VND</div>
                        </div>
                    </div>
                </div>

                <form asp-action="CheckOut" method="post">
                    <input type="hidden" asp-for="BookingId" />
                    <input type="hidden" asp-for="BookingCode" />

                    @if (Model.BalanceDue > 0)
                    {
                        <div class="mb-3">
                            <label asp-for="DirectPaymentCollected" class="form-label fw-bold">Collect Remaining Balance at Counter (VND):</label>
                            <input asp-for="DirectPaymentCollected" class="form-control form-control-lg fw-bold text-success" />
                        </div>

                        <div class="form-check mb-4">
                            <input asp-for="MarkAsUnsettledDebt" class="form-check-input" type="checkbox" id="unsettledCheck" />
                            <label class="form-check-label text-danger fw-semibold" for="unsettledCheck">
                                Customer unable to pay remaining balance: Mark as UNSETTLED Debt (UC20)
                            </label>
                        </div>
                    }

                    <div class="border rounded p-3 mb-4 bg-light">
                        <h6 class="fw-bold mb-2"><i class="bi bi-shield-check"></i> Pitch Condition Inspection:</h6>
                        <div class="form-check mb-2">
                            <input asp-for="IsDamaged" class="form-check-input" type="checkbox" id="damageCheck" />
                            <label class="form-check-label text-warning fw-bold text-dark" for="damageCheck">
                                Pitch is Damaged / Turf needs repair (Pitch status will become MAINTENANCE).
                            </label>
                        </div>
                        <div class="mb-2">
                            <label asp-for="DamageNote" class="form-label small">Damage Description (if any):</label>
                            <input asp-for="DamageNote" class="form-control" placeholder="e.g. Torn net, damaged turf near goalpost..." />
                        </div>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary btn-lg fw-semibold py-3 shadow-sm">
                            <i class="bi bi-check-all"></i> Complete Check-Out
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Back to Front Desk</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

