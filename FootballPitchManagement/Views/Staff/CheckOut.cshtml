@model FootballPitchManagement.Models.ViewModels.CheckOutVM

@{
    ViewData["Title"] = "Trả Sân & Quyết Toán Cuối Trận";
}

<div class="row justify-content-center">
    <div class="col-lg-7 col-md-9">
        <div class="card shadow border-0 rounded-4 overflow-hidden">
            <div class="card-header bg-primary text-white py-3 px-4">
                <h4 class="mb-0 fw-bold d-flex align-items-center">
                    <i class="bi bi-box-arrow-right me-2"></i> Trả Sân & Nghiệm Thu Trận Đấu
                </h4>
            </div>
            <div class="card-body p-4">
                <div class="card bg-light border-0 rounded-3 mb-4">
                    <div class="card-body p-3">
                        <div class="row mb-2">
                            <div class="col-sm-4 text-muted">Mã đơn đặt:</div>
                            <div class="col-sm-8 fw-bold text-dark">@Model.BookingCode</div>
                        </div>
                        <div class="row mb-2">
                            <div class="col-sm-4 text-muted">Sân bóng:</div>
                            <div class="col-sm-8 fw-bold">@Model.FieldName</div>
                        </div>
                        <div class="row mb-2">
                            <div class="col-sm-4 text-muted">Khách hàng:</div>
                            <div class="col-sm-8">@Model.CustomerInfo</div>
                        </div>
                        <div class="row mb-2">
                            <div class="col-sm-4 text-muted">Tổng tiền sân:</div>
                            <div class="col-sm-8">@Model.AgreedPrice.ToString("N0") đ</div>
                        </div>
                        <div class="row mb-2">
                            <div class="col-sm-4 text-muted">Tiền đã thanh toán:</div>
                            <div class="col-sm-8 text-success fw-bold">@Model.PaidAmount.ToString("N0") đ</div>
                        </div>
                        <div class="row">
                            <div class="col-sm-4 text-muted">Tiền còn thiếu:</div>
                            <div class="col-sm-8 fs-4 fw-bold text-danger">@Model.BalanceDue.ToString("N0") đ</div>
                        </div>
                    </div>
                </div>

                <form asp-action="CheckOut" method="post">
                    <input type="hidden" asp-for="BookingId" />
                    <input type="hidden" asp-for="BookingCode" />

                    @if (Model.BalanceDue > 0)
                    {
                        <div class="mb-3">
                            <label asp-for="DirectPaymentCollected" class="form-label fw-bold text-dark">
                                Thu số tiền còn thiếu tại quầy (VND):
                            </label>
                            <input asp-for="DirectPaymentCollected" class="form-control form-control-lg fw-bold text-success" />
                        </div>

                        <div class="form-check mb-4">
                            <input asp-for="MarkAsUnsettledDebt" class="form-check-input" type="checkbox" id="unsettledCheck" />
                            <label class="form-check-label text-danger fw-semibold" for="unsettledCheck">
                                Khách chưa thanh toán nốt: Đánh dấu ghi nợ chưa quyết toán (UNSETTLED)
                            </label>
                        </div>
                    }

                    <div class="border rounded-3 p-3 mb-4 bg-light">
                        <h6 class="fw-bold mb-2 text-dark"><i class="bi bi-shield-check text-success me-1"></i> Nghiệm Thu Hiện Trạng Sân Sau Trận:</h6>
                        <div class="form-check mb-2">
                            <input asp-for="IsDamaged" class="form-check-input" type="checkbox" id="damageCheck" />
                            <label class="form-check-label text-warning text-dark fw-bold" for="damageCheck">
                                Phát hiện hư hỏng mặt cỏ / rách lưới bóng (Sân sẽ tự động chuyển sang BẢO TRÌ).
                            </label>
                        </div>
                        <div class="mb-2">
                            <label asp-for="DamageNote" class="form-label small">Ghi chú chi tiết hư hỏng (nếu có):</label>
                            <input asp-for="DamageNote" class="form-control" placeholder="Ví dụ: Rách lưới khung thành phía Tây, tróc mặt cỏ..." />
                        </div>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary btn-lg fw-bold py-3 shadow-sm">
                            <i class="bi bi-check2-all me-1"></i> Hoàn Tất Thủ Tục Trả Sân
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary py-2">Quay lại bàn lễ tân</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
