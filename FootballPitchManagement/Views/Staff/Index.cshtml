@model IEnumerable<FootballPitchManagement.Models.Entities.Booking>

@{
    ViewData["Title"] = "Front Desk & Reception Portal";
    var targetDate = (DateTime)ViewBag.TargetDate;
    var fields = (List<FootballPitchManagement.Models.Entities.FootballField>)ViewBag.Fields;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-person-workspace text-warning"></i> Front Desk Operations</h2>
        <p class="text-muted mb-0">Check-in, Check-out, Counter booking, Direct payments & No-show management</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="WalkIn" class="btn btn-success fw-semibold">
            <i class="bi bi-plus-circle"></i> Create Walk-in Booking (UC37)
        </a>
        <a asp-action="RefundQueue" class="btn btn-outline-info text-dark fw-semibold">
            <i class="bi bi-arrow-counterclockwise"></i> Refund Queue (UC34)
        </a>
    </div>
</div>

<!-- Date Picker Filter -->
<div class="card shadow-sm border-0 mb-4">
    <div class="card-body p-3">
        <form method="get" asp-action="Index" class="row g-3 align-items-center">
            <div class="col-auto">
                <label class="col-form-label fw-bold"><i class="bi bi-calendar3"></i> Selected Date:</label>
            </div>
            <div class="col-auto">
                <input type="date" name="date" class="form-control" value="@targetDate.ToString("yyyy-MM-dd")" onchange="this.form.submit()" />
            </div>
            <div class="col-auto">
                <a asp-action="Index" asp-route-date="@DateTime.Today.ToString("yyyy-MM-dd")" class="btn btn-outline-secondary">Today</a>
            </div>
        </form>
    </div>
</div>

<!-- Bookings Operation Table -->
<div class="card shadow-sm border-0">
    <div class="card-header bg-white py-3">
        <h5 class="fw-bold mb-0">Bookings for @targetDate.ToString("dddd, dd/MM/yyyy")</h5>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Booking Code</th>
                        <th>Pitch</th>
                        <th>Slot Time</th>
                        <th>Customer / Contact</th>
                        <th>Price / Paid / Due</th>
                        <th>Settlement</th>
                        <th>Status</th>
                        <th class="text-center">Operations</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var b in Model)
                        {
                            <tr>
                                <td class="fw-bold text-primary">@b.BookingCode</td>
                                <td>
                                    <span class="fw-semibold">@b.Field?.Name</span>
                                    <small class="badge bg-secondary d-block mt-1">@b.Field?.FieldType</small>
                                </td>
                                <td>
                                    <div class="fw-semibold">@b.TimeSlot?.SlotName</div>
                                    <small class="text-muted">@b.TimeSlot?.StartTime.ToString(@"hh\:mm") - @b.TimeSlot?.EndTime.ToString(@"hh\:mm")</small>
                                </td>
                                <td>
                                    <div class="fw-semibold">@(b.Account?.FullName ?? b.GuestName ?? "Guest")</div>
                                    <small class="text-muted"><i class="bi bi-phone"></i> @(b.Account?.Phone ?? b.GuestPhone)</small>
                                </td>
                                <td>
                                    <div>Agreed: <strong>@b.AgreedPrice.ToString("N0")</strong></div>
                                    <div class="text-success small">Paid: @b.PaidAmount.ToString("N0")</div>
                                    @if (b.BalanceDue > 0)
                                    {
                                        <div class="text-danger small fw-bold">Due: @b.BalanceDue.ToString("N0")</div>
                                    }
                                </td>
                                <td>
                                    <span class="badge @(b.SettlementStatus == FootballPitchManagement.Models.Enums.SettlementStatus.PAID ? "bg-success" : (b.SettlementStatus == FootballPitchManagement.Models.Enums.SettlementStatus.UNSETTLED ? "bg-danger" : "bg-warning text-dark"))">
                                        @b.SettlementStatus
                                    </span>
                                </td>
                                <td>
                                    @{
                                        string badge = b.Status switch
                                        {
                                            FootballPitchManagement.Models.Enums.BookingStatus.CONFIRMED => "bg-success",
                                            FootballPitchManagement.Models.Enums.BookingStatus.CHECKED_IN => "bg-info text-dark",
                                            FootballPitchManagement.Models.Enums.BookingStatus.PENDING_PAYMENT => "bg-warning text-dark",
                                            FootballPitchManagement.Models.Enums.BookingStatus.COMPLETED => "bg-primary",
                                            FootballPitchManagement.Models.Enums.BookingStatus.CANCELLED => "bg-secondary",
                                            FootballPitchManagement.Models.Enums.BookingStatus.EXPIRED => "bg-dark",
                                            FootballPitchManagement.Models.Enums.BookingStatus.NO_SHOW => "bg-danger",
                                            _ => "bg-secondary"
                                        };
                                    }
                                    <span class="badge @badge">@b.Status</span>
                                </td>
                                <td class="text-center">
                                    <div class="btn-group btn-group-sm">
                                        @if (b.Status == FootballPitchManagement.Models.Enums.BookingStatus.CONFIRMED)
                                        {
                                            <!-- Check-in (UC19) -->
                                            <form asp-action="CheckIn" asp-route-id="@b.BookingId" method="post" class="d-inline">
                                                <button type="submit" class="btn btn-success" title="Check In Customer (UC19)">
                                                    <i class="bi bi-box-arrow-in-right"></i> Check In
                                                </button>
                                            </form>
                                            <!-- Record Direct Payment (UC23) -->
                                            <a asp-action="RecordPayment" asp-route-id="@b.BookingId" class="btn btn-warning text-dark" title="Record Direct Payment (UC23)">
                                                <i class="bi bi-cash"></i> Pay
                                            </a>
                                            <!-- No-Show (UC35) -->
                                            <form asp-action="NoShow" asp-route-id="@b.BookingId" method="post" class="d-inline" onsubmit="return confirm('Confirm marking as No-Show? Paid prepayment will be retained.');">
                                                <button type="submit" class="btn btn-outline-danger" title="Record No Show (UC35)">
                                                    <i class="bi bi-person-x"></i> No-Show
                                                </button>
                                            </form>
                                        }
                                        else if (b.Status == FootballPitchManagement.Models.Enums.BookingStatus.CHECKED_IN)
                                        {
                                            <!-- Check-out (UC20) -->
                                            <a asp-action="CheckOut" asp-route-id="@b.BookingId" class="btn btn-primary" title="Check Out Customer (UC20)">
                                                <i class="bi bi-box-arrow-right"></i> Check Out
                                            </a>
                                            <!-- Record Direct Payment (UC23) -->
                                            @if (b.BalanceDue > 0)
                                            {
                                                <a asp-action="RecordPayment" asp-route-id="@b.BookingId" class="btn btn-warning text-dark" title="Record Direct Payment (UC23)">
                                                    <i class="bi bi-cash"></i> Pay
                                                </a>
                                            }
                                        }
                                        else if (b.Status == FootballPitchManagement.Models.Enums.BookingStatus.PENDING_PAYMENT)
                                        {
                                            <!-- Record Direct Payment (UC23) -->
                                            <a asp-action="RecordPayment" asp-route-id="@b.BookingId" class="btn btn-warning text-dark" title="Record Direct Payment (UC23)">
                                                <i class="bi bi-cash"></i> Record Payment
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">No action</span>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center py-4 text-muted">No bookings scheduled for this date.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

