@model IEnumerable<FootballPitchManagement.Models.Entities.Booking>

@{
    ViewData["Title"] = "Bàn Điều Độ Lễ Tân & Trực Sân";
    var targetDate = (DateTime)ViewBag.TargetDate;
    var fields = (List<FootballPitchManagement.Models.Entities.FootballField>)ViewBag.Fields;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1 text-dark"><i class="bi bi-person-workspace text-primary"></i> Quầy Lễ Tân & Điều Độ Trận Đấu</h2>
        <p class="text-muted mb-0">Tiếp đón khách, check-in vào sân, thu tiền trực tiếp, nghiệm thu trả sân và xử lý vắng mặt</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="WalkIn" class="btn btn-success fw-bold px-3 shadow-sm">
            <i class="bi bi-plus-circle me-1"></i> Đặt Sân Vãng Lai Tại Quầy
        </a>
        <a asp-action="RefundQueue" class="btn btn-outline-primary fw-semibold">
            <i class="bi bi-arrow-counterclockwise me-1"></i> Hàng Đợi Hoàn Tiền
        </a>
    </div>
</div>

<!-- Lọc ngày điều độ -->
<div class="card shadow-sm border-0 mb-4 rounded-4">
    <div class="card-body p-3 bg-white rounded-4">
        <form method="get" asp-action="Index" class="row g-3 align-items-center">
            <div class="col-auto">
                <label class="col-form-label fw-bold"><i class="bi bi-calendar-event text-primary me-1"></i> Ngày điều độ ca trực:</label>
            </div>
            <div class="col-auto">
                <input type="date" name="date" class="form-control" value="@targetDate.ToString("yyyy-MM-dd")" onchange="this.form.submit()" />
            </div>
            <div class="col-auto">
                <a asp-action="Index" asp-route-date="@DateTime.Today.ToString("yyyy-MM-dd")" class="btn btn-outline-secondary">Hôm Nay</a>
            </div>
        </form>
    </div>
</div>

<!-- Bảng danh sách ca trực -->
<div class="card shadow-sm border-0 rounded-4 overflow-hidden">
    <div class="card-header bg-white py-3 px-4 border-0">
        <h5 class="fw-bold mb-0 text-dark">
            <i class="bi bi-list-check text-success me-1"></i> Lịch thi đấu ngày @targetDate.ToString("dd/MM/yyyy")
        </h5>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Mã Đơn</th>
                        <th>Sân Bóng</th>
                        <th>Ca Đá / Giờ</th>
                        <th>Khách Hàng / SĐT</th>
                        <th>Chi Phí (Giá / Đã Thu / Nợ)</th>
                        <th>Thanh Toán</th>
                        <th>Trạng Thái</th>
                        <th class="text-center" style="min-width: 260px;">Thao Tác Lễ Tân</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var b in Model)
                        {
                            <tr>
                                <td class="fw-bold text-primary">@b.BookingCode</td>
                                <td>
                                    <span class="fw-bold text-dark">@b.Field?.Name</span>
                                    <small class="badge bg-secondary d-block mt-1">
                                        @(b.Field?.FieldType == FootballPitchManagement.Models.Enums.FieldType.FIELD_5 ? "Sân 5" : (b.Field?.FieldType == FootballPitchManagement.Models.Enums.FieldType.FIELD_7 ? "Sân 7" : "Sân 11"))
                                    </small>
                                </td>
                                <td>
                                    <div class="fw-bold">@b.TimeSlot?.SlotName</div>
                                    <small class="text-muted"><i class="bi bi-clock me-1"></i> @b.TimeSlot?.StartTime.ToString(@"hh\:mm") - @b.TimeSlot?.EndTime.ToString(@"hh\:mm")</small>
                                </td>
                                <td>
                                    <div class="fw-bold text-dark">@(b.Account?.FullName ?? b.GuestName ?? "Khách vãng lai")</div>
                                    <small class="text-muted"><i class="bi bi-telephone me-1"></i> @(b.Account?.Phone ?? b.GuestPhone)</small>
                                </td>
                                <td>
                                    <div>Tổng: <strong>@b.AgreedPrice.ToString("N0") đ</strong></div>
                                    <div class="text-success small fw-bold">Đã thu: @b.PaidAmount.ToString("N0") đ</div>
                                    @if (b.BalanceDue > 0)
                                    {
                                        <div class="text-danger small fw-bold">Còn thiếu: @b.BalanceDue.ToString("N0") đ</div>
                                    }
                                </td>
                                <td>
                                    @{
                                        (string sBadge, string sText) = b.SettlementStatus switch
                                        {
                                            FootballPitchManagement.Models.Enums.SettlementStatus.PAID => ("bg-success", "Đã thanh toán đủ"),
                                            FootballPitchManagement.Models.Enums.SettlementStatus.PARTIALLY_PAID => ("bg-warning text-dark", "Đã cọc một phần"),
                                            FootballPitchManagement.Models.Enums.SettlementStatus.UNSETTLED => ("bg-danger", "Nợ chưa quyết toán"),
                                            _ => ("bg-secondary", "Chưa trả tiền")
                                        };
                                    }
                                    <span class="badge @sBadge">@sText</span>
                                </td>
                                <td>
                                    @{
                                        (string bBadge, string bText) = b.Status switch
                                        {
                                            FootballPitchManagement.Models.Enums.BookingStatus.CONFIRMED => ("bg-success", "Đã xác nhận"),
                                            FootballPitchManagement.Models.Enums.BookingStatus.CHECKED_IN => ("bg-info text-dark", "Đang thi đấu"),
                                            FootballPitchManagement.Models.Enums.BookingStatus.PENDING_PAYMENT => ("bg-warning text-dark", "Chờ thu cọc"),
                                            FootballPitchManagement.Models.Enums.BookingStatus.COMPLETED => ("bg-primary", "Đã hoàn thành"),
                                            FootballPitchManagement.Models.Enums.BookingStatus.CANCELLED => ("bg-secondary", "Đã hủy"),
                                            FootballPitchManagement.Models.Enums.BookingStatus.EXPIRED => ("bg-dark", "Hết hạn"),
                                            FootballPitchManagement.Models.Enums.BookingStatus.NO_SHOW => ("bg-danger", "Vắng mặt"),
                                            _ => ("bg-secondary", b.Status.ToString())
                                        };
                                    }
                                    <span class="badge @bBadge">@bText</span>
                                </td>
                                <td class="text-center">
                                    <div class="btn-group btn-group-sm">
                                        @if (b.Status == FootballPitchManagement.Models.Enums.BookingStatus.CONFIRMED)
                                        {
                                            <!-- Check-in vào sân -->
                                            <form asp-action="CheckIn" asp-route-id="@b.BookingId" method="post" class="d-inline">
                                                <button type="submit" class="btn btn-success fw-bold" title="Nhận khách vào sân">
                                                    <i class="bi bi-box-arrow-in-right"></i> Check-in
                                                </button>
                                            </form>
                                            <!-- Thu tiền tại quầy -->
                                            <a asp-action="RecordPayment" asp-route-id="@b.BookingId" class="btn btn-warning text-dark fw-semibold" title="Thu tiền cọc / tiền sân">
                                                <i class="bi bi-cash"></i> Thu Tiền
                                            </a>
                                            <!-- Báo vắng mặt No-show -->
                                            <form asp-action="NoShow" asp-route-id="@b.BookingId" method="post" class="d-inline" onsubmit="return confirm('Xác nhận khách vắng mặt (No-Show)? Tiền cọc sẽ được giữ lại theo quy định.');">
                                                <button type="submit" class="btn btn-outline-danger" title="Ghi nhận khách không đến">
                                                    <i class="bi bi-person-x"></i> Vắng Mặt
                                                </button>
                                            </form>
                                        }
                                        else if (b.Status == FootballPitchManagement.Models.Enums.BookingStatus.CHECKED_IN)
                                        {
                                            <!-- Trả sân Check-out -->
                                            <a asp-action="CheckOut" asp-route-id="@b.BookingId" class="btn btn-primary fw-bold" title="Nghiệm thu sân và trả sân">
                                                <i class="bi bi-box-arrow-right"></i> Trả Sân
                                            </a>
                                            @if (b.BalanceDue > 0)
                                            {
                                                <a asp-action="RecordPayment" asp-route-id="@b.BookingId" class="btn btn-warning text-dark fw-semibold" title="Thu tiền còn thiếu">
                                                    <i class="bi bi-cash"></i> Thu Tiền
                                                </a>
                                            }
                                        }
                                        else if (b.Status == FootballPitchManagement.Models.Enums.BookingStatus.PENDING_PAYMENT)
                                        {
                                            <a asp-action="RecordPayment" asp-route-id="@b.BookingId" class="btn btn-warning text-dark fw-semibold" title="Thu tiền cọc trực tiếp tại quầy">
                                                <i class="bi bi-cash"></i> Thu Tiền
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">Đã kết thúc</span>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center py-5 text-muted">Không có lịch thi đấu nào trong ngày này.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
