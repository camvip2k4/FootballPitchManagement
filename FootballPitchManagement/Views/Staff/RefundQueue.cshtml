@model IEnumerable<FootballPitchManagement.Models.Entities.RefundRequest>

@{
    ViewData["Title"] = "Refund Queue (UC34)";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-arrow-counterclockwise text-info"></i> Refund Management Queue (UC34)</h2>
        <p class="text-muted mb-0">Review and execute customer, facility, and late-payment refund requests</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left"></i> Back to Front Desk
    </a>
</div>

<div class="table-responsive bg-white rounded shadow-sm p-3">
    <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
            <tr>
                <th>Refund Code</th>
                <th>Booking Code</th>
                <th>Pitch</th>
                <th>Refund Amount</th>
                <th>Type</th>
                <th>Reason</th>
                <th>Status</th>
                <th>Created At</th>
                <th class="text-center">Action</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                @foreach (var r in Model)
                {
                    <tr>
                        <td class="fw-bold text-primary">@r.RefundCode</td>
                        <td>@(r.Booking?.BookingCode ?? "N/A")</td>
                        <td>@(r.Booking?.Field?.Name ?? "Field")</td>
                        <td class="fw-bold text-success fs-6">@r.Amount.ToString("N0") VND</td>
                        <td>
                            <span class="badge @(r.RefundType == FootballPitchManagement.Models.Enums.RefundType.FACILITY_CANCEL ? "bg-danger" : (r.RefundType == FootballPitchManagement.Models.Enums.RefundType.LATE_PAYMENT ? "bg-warning text-dark" : "bg-info text-dark"))">
                                @r.RefundType
                            </span>
                        </td>
                        <td><small class="text-muted">@r.Reason</small></td>
                        <td>
                            <span class="badge @(r.Status == FootballPitchManagement.Models.Enums.RefundStatus.SUCCESS ? "bg-success" : (r.Status == FootballPitchManagement.Models.Enums.RefundStatus.PENDING ? "bg-warning text-dark" : "bg-danger"))">
                                @r.Status
                            </span>
                        </td>
                        <td><small>@r.CreatedAt.ToString("dd/MM/yyyy HH:mm")</small></td>
                        <td class="text-center">
                            @if (r.Status == FootballPitchManagement.Models.Enums.RefundStatus.PENDING)
                            {
                                <a asp-action="ProcessRefund" asp-route-id="@r.RefundId" class="btn btn-primary btn-sm">
                                    <i class="bi bi-gear"></i> Process
                                </a>
                            }
                            else
                            {
                                <small class="text-muted">Proof: @r.EvidenceProof</small>
                            }
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="9" class="text-center py-4 text-muted">No refund requests in the queue.</td>
                </tr>
            }
        </tbody>
    </table>
</div>

