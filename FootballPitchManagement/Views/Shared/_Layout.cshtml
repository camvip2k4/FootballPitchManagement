<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SPORT ARENA | Hệ Thống Quản Lý Sân Bóng Đá</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        :root {
            --primary-sport: #0d6efd;
            --secondary-sport: #10b981;
            --dark-sport: #0f172a;
        }
        body {
            font-family: system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
            color: #1e293b;
        }
        .hero-banner {
            background: linear-gradient(135deg, #064e3b 0%, #065f46 50%, #047857 100%);
            color: white;
            padding: 3.5rem 2rem;
            border-radius: 1.25rem;
            margin-bottom: 2rem;
            box-shadow: 0 10px 25px -5px rgba(6, 78, 59, 0.3);
        }
        .navbar-brand-custom {
            font-weight: 800;
            letter-spacing: 0.5px;
            font-size: 1.35rem;
        }
        .badge-status {
            font-size: 0.85rem;
            padding: 0.35rem 0.65rem;
            border-radius: 0.375rem;
            font-weight: 600;
        }
        .nav-admin-pill {
            background: rgba(13, 110, 253, 0.15);
            border: 1px solid rgba(13, 110, 253, 0.4);
            border-radius: 0.5rem;
            color: #60a5fa !important;
            font-weight: 700;
        }
        .nav-admin-pill:hover {
            background: rgba(13, 110, 253, 0.3);
            color: #ffffff !important;
        }
        .nav-staff-pill {
            background: rgba(245, 158, 11, 0.15);
            border: 1px solid rgba(245, 158, 11, 0.4);
            border-radius: 0.5rem;
            color: #fbbf24 !important;
            font-weight: 700;
        }
        .nav-staff-pill:hover {
            background: rgba(245, 158, 11, 0.3);
            color: #ffffff !important;
        }
        .footer-custom {
            background: linear-gradient(180deg, #0b1329 0%, #030712 100%);
            border-top: 4px solid #10b981;
            color: #f1f5f9;
        }
        .footer-custom h5 {
            color: #ffffff;
            font-weight: 700;
            letter-spacing: 0.5px;
            margin-bottom: 1.25rem;
        }
        .footer-custom p {
            color: #e2e8f0;
            font-size: 0.95rem;
            line-height: 1.7;
        }
        .footer-custom li {
            color: #f8fafc;
            font-size: 0.95rem;
            line-height: 1.8;
            margin-bottom: 0.5rem;
        }
        .footer-custom a.text-secondary {
            color: #94a3b8 !important;
            transition: color 0.15s ease;
        }
        .footer-custom a.text-secondary:hover {
            color: #38bdf8 !important;
        }
        .footer-bottom {
            background: #020617;
            color: #cbd5e1;
            font-size: 0.9rem;
            border-top: 1px solid #1e293b;
        }
    </style>
</head>
<body class="bg-light d-flex flex-column min-vh-100">
    @{
        var roleClaim = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value?.ToUpper() ?? "";
        bool isStaff = roleClaim == "STAFF" || roleClaim == "MANAGER" || roleClaim == "ADMIN" || User.IsInRole("STAFF") || User.IsInRole("Staff") || User.IsInRole("MANAGER") || User.IsInRole("Manager") || User.IsInRole("ADMIN") || User.IsInRole("Admin");
        bool isManager = roleClaim == "MANAGER" || roleClaim == "ADMIN" || User.IsInRole("MANAGER") || User.IsInRole("Manager") || User.IsInRole("ADMIN") || User.IsInRole("Admin");
        bool isAdmin = roleClaim == "ADMIN" || User.IsInRole("ADMIN") || User.IsInRole("Admin");

        string roleBadge = roleClaim switch
        {
            "ADMIN" => "bg-danger",
            "MANAGER" => "bg-primary",
            "STAFF" => "bg-warning text-dark",
            _ => "bg-success"
        };
        string roleTitle = roleClaim switch
        {
            "ADMIN" => "Quản Trị Viên (Admin)",
            "MANAGER" => "Quản Lý Cơ Sở (Manager)",
            "STAFF" => "Nhân Viên Lễ Tân (Staff)",
            _ => "Khách Hàng"
        };
    }

    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark py-3 shadow-sm sticky-top">
            <div class="container-fluid px-lg-5">
                <a class="navbar-brand navbar-brand-custom text-success d-flex align-items-center" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-dribbble text-warning me-2 fs-3"></i>
                    <span>SPORT ARENA</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain"
                        aria-controls="navbarMain" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarMain">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 fw-medium gap-1">
                        <li class="nav-item">
                            <a class="nav-link px-3" asp-area="" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house-door me-1"></i> Trang Chủ
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link px-3 text-warning fw-semibold" asp-area="" asp-controller="Field" asp-action="Index">
                                <i class="bi bi-calendar2-check me-1"></i> Đặt Sân Thi Đấu
                            </a>
                        </li>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <a class="nav-link px-3" asp-area="" asp-controller="Booking" asp-action="MyBookings">
                                    <i class="bi bi-receipt me-1"></i> Đơn Đặt Của Tôi
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link px-3" asp-area="" asp-controller="Booking" asp-action="Notifications">
                                    <i class="bi bi-bell me-1"></i> Thông Báo
                                </a>
                            </li>
                        }

                        <!-- Menu nghiệp vụ dành riêng cho Nhân viên Lễ tân -->
                        @if (isStaff)
                        {
                            <li class="nav-item ms-lg-2">
                                <a class="nav-link px-3 nav-staff-pill" asp-area="" asp-controller="Staff" asp-action="Index">
                                    <i class="bi bi-person-workspace me-1"></i> Bàn Lễ Tân & Điều Độ
                                </a>
                            </li>
                        }

                        <!-- Menu nghiệp vụ dành riêng cho Quản lý & Admin -->
                        @if (isManager)
                        {
                            <li class="nav-item dropdown ms-lg-2">
                                <a class="nav-link dropdown-toggle px-3 nav-admin-pill d-flex align-items-center gap-1" href="#" id="adminDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-sliders me-1"></i> Quản Trị Hệ Thống
                                </a>
                                <ul class="dropdown-menu shadow-lg border-0 py-2 mt-2" aria-labelledby="adminDropdown">
                                    <li>
                                        <a class="dropdown-item py-2 fw-semibold text-primary" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                                            <i class="bi bi-speedometer2 me-2"></i> Báo Cáo Doanh Thu & KPI
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <a class="dropdown-item py-2" asp-area="Admin" asp-controller="FieldManagement" asp-action="Index">
                                            <i class="bi bi-grid-3x3 text-success me-2"></i> Quản Lý Danh Mục Sân Bóng
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item py-2" asp-area="Admin" asp-controller="PricingManagement" asp-action="Index">
                                            <i class="bi bi-tags-fill text-warning me-2"></i> Thiết Lập Bảng Giá Động
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item py-2" asp-area="Admin" asp-controller="PolicyManagement" asp-action="Index">
                                            <i class="bi bi-sliders text-info me-2"></i> Cấu Hình Chính Sách (POL-01..07)
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item py-2" asp-area="Admin" asp-controller="FacilityCancel" asp-action="Index">
                                            <i class="bi bi-cloud-lightning-rain-fill text-danger me-2"></i> Hủy Sân Do Sự Cố / Mưa Bão (Hoàn 100%)
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item py-2" asp-area="" asp-controller="Staff" asp-action="RefundQueue">
                                            <i class="bi bi-arrow-counterclockwise text-primary me-2"></i> Hàng Đợi Duyệt Hoàn Tiền
                                        </a>
                                    </li>
                                    @if (isAdmin)
                                    {
                                        <li><hr class="dropdown-divider"></li>
                                        <li>
                                            <a class="dropdown-item py-2 text-danger fw-semibold" asp-area="Admin" asp-controller="AccountManagement" asp-action="Index">
                                                <i class="bi bi-people-fill me-2"></i> Quản Trị Người Dùng & Phân Quyền
                                            </a>
                                        </li>
                                    }
                                </ul>
                            </li>
                        }
                    </ul>

                    <ul class="navbar-nav ms-auto mb-2 mb-lg-0 align-items-center">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-white d-flex align-items-center gap-2 py-1 px-3 border border-secondary rounded-pill bg-dark" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-person-circle fs-5 text-warning"></i>
                                    <span class="fw-bold">@User.Identity.Name</span>
                                    <span class="badge @roleBadge">@roleTitle</span>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0 py-2 mt-2" aria-labelledby="userDropdown">
                                    <li class="px-3 py-2 border-bottom bg-light">
                                        <div class="fw-bold text-dark">@User.FindFirst(System.Security.Claims.ClaimTypes.GivenName)?.Value</div>
                                        <small class="badge @roleBadge">@roleTitle</small>
                                    </li>
                                    @if (isManager)
                                    {
                                        <li>
                                            <a class="dropdown-item py-2 text-primary fw-bold" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                                                <i class="bi bi-speedometer2 me-2"></i> Trung Tâm Quản Trị Admin
                                            </a>
                                        </li>
                                    }
                                    @if (isStaff)
                                    {
                                        <li>
                                            <a class="dropdown-item py-2 text-success fw-bold" asp-area="" asp-controller="Staff" asp-action="Index">
                                                <i class="bi bi-person-workspace me-2"></i> Bàn Điều Độ Lễ Tân
                                            </a>
                                        </li>
                                    }
                                    <li><a class="dropdown-item py-2" asp-area="" asp-controller="Booking" asp-action="MyBookings"><i class="bi bi-calendar3 me-2 text-secondary"></i> Lịch Đặt Sân Của Tôi</a></li>
                                    <li><a class="dropdown-item py-2" asp-area="" asp-controller="Booking" asp-action="Notifications"><i class="bi bi-bell me-2 text-secondary"></i> Hộp Thư Thông Báo</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <form asp-area="" asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                            <button type="submit" class="dropdown-item py-2 text-danger fw-semibold">
                                                <i class="bi bi-box-arrow-right me-2"></i> Đăng Xuất Khỏi Hệ Thống
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item me-2">
                                <a class="btn btn-outline-light btn-sm px-3 py-2 fw-semibold" asp-area="" asp-controller="Account" asp-action="Login">
                                    <i class="bi bi-box-arrow-in-right me-1"></i> Đăng Nhập
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-success btn-sm px-3 py-2 fw-bold shadow-sm" asp-area="" asp-controller="Account" asp-action="Register">
                                    <i class="bi bi-person-plus me-1"></i> Đăng Ký Tài Khoản
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container my-4 flex-grow-1">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show shadow-sm border-0 d-flex align-items-center rounded-3 p-3" role="alert">
                <i class="bi bi-check-circle-fill me-2 fs-4 text-success"></i>
                <div class="fw-semibold">@TempData["SuccessMessage"]</div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show shadow-sm border-0 d-flex align-items-center rounded-3 p-3" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2 fs-4 text-danger"></i>
                <div class="fw-semibold">@TempData["ErrorMessage"]</div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <main role="main" class="pb-4">
            @RenderBody()
        </main>
    </div>

    <!-- FOOTER CAO CẤP RÕ RÀNG NỔI BẬT CHUẨN THƯƠNG MẠI -->
    <footer class="footer-custom pt-5 mt-auto">
        <div class="container pb-4">
            <div class="row g-4">
                <div class="col-lg-4 col-md-6">
                    <h5 class="fw-bold d-flex align-items-center text-success">
                        <i class="bi bi-dribbble text-warning me-2 fs-4"></i> SPORT ARENA
                    </h5>
                    <p class="mb-3">
                        Tổ hợp sân bóng đá cỏ nhân tạo cao cấp đạt tiêu chuẩn thi đấu FIFA. Cung cấp trải nghiệm thể thao đỉnh cao, hệ thống đặt sân trực tuyến minh bạch, tiện lợi 24/7 và dịch vụ chăm sóc khách hàng tận tâm.
                    </p>
                    <div class="d-flex gap-3 fs-5">
                        <a href="#" class="text-secondary" title="Facebook"><i class="bi bi-facebook fs-4"></i></a>
                        <a href="#" class="text-secondary" title="YouTube"><i class="bi bi-youtube fs-4"></i></a>
                        <a href="#" class="text-secondary" title="TikTok"><i class="bi bi-tiktok fs-4"></i></a>
                    </div>
                </div>
                <div class="col-lg-4 col-md-6">
                    <h5><i class="bi bi-telephone-inbound-fill text-warning me-2"></i> Liên Hệ & Đặt Sân Trực Tiếp</h5>
                    <ul class="list-unstyled mb-0">
                        <li>
                            <i class="bi bi-geo-alt-fill text-danger me-2"></i>
                            <strong>Địa chỉ:</strong> Khu Liên Hợp Thể Thao Sport Arena, Hà Nội
                        </li>
                        <li>
                            <i class="bi bi-telephone-fill text-warning me-2"></i>
                            <strong>Hotline đặt sân:</strong> <span class="text-warning fw-bold fs-6">0987.654.321</span>
                        </li>
                        <li>
                            <i class="bi bi-envelope-fill text-info me-2"></i>
                            <strong>Email hỗ trợ:</strong> lienhe@sportarena.vn
                        </li>
                        <li>
                            <i class="bi bi-clock-fill text-success me-2"></i>
                            <strong>Giờ mở cửa:</strong> <span class="text-success fw-bold">06:00 - 23:00</span> (Tất cả các ngày trong tuần)
                        </li>
                    </ul>
                </div>
                <div class="col-lg-4 col-md-12">
                    <h5><i class="bi bi-shield-check text-success me-2"></i> Cam Kết Dịch Vụ</h5>
                    <ul class="list-unstyled mb-0">
                        <li>
                            <i class="bi bi-check-circle-fill text-success me-2"></i>
                            <strong>Tạm giữ chỗ 15 phút:</strong> Khóa slot độc quyền để bạn thong thả chuyển khoản.
                        </li>
                        <li>
                            <i class="bi bi-check-circle-fill text-success me-2"></i>
                            <strong>Bồi hoàn 100% tiền cọc:</strong> Khi hủy do thời tiết mưa bão ngập sân hoặc sự cố kỹ thuật.
                        </li>
                        <li>
                            <i class="bi bi-check-circle-fill text-success me-2"></i>
                            <strong>Thanh toán VietQR tiện lợi:</strong> Tự động nhận diện giao dịch ngân hàng trong 30 giây.
                        </li>
                        <li>
                            <i class="bi bi-check-circle-fill text-success me-2"></i>
                            <strong>Cơ sở vật chất chuẩn FIFA:</strong> Hệ thống đèn LED chống lóa và dàn mặt cỏ thế hệ mới.
                        </li>
                    </ul>
                </div>
            </div>
        </div>
        <div class="footer-bottom py-3">
            <div class="container text-center">
                <span>&copy; 2026 <strong>SPORT ARENA</strong> - Nền Tảng Quản Lý & Vận Hành Sân Bóng Đá Chuyên Nghiệp.</span>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
