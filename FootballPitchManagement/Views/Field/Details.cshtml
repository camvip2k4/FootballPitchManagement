@model FootballPitchManagement.Models.ViewModels.FieldCardVM

@{
    ViewData["Title"] = Model.Name + " - Details & Time Slots";
    var searchDate = (DateTime)ViewBag.SearchDate;
}

<div class="mb-4">
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm mb-3">
        <i class="bi bi-arrow-left"></i> Back to Field Search
    </a>
    <div class="card shadow-sm border-0">
        <div class="card-body p-4">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <h2 class="fw-bold text-primary mb-1">@Model.Name</h2>
                    <span class="badge bg-secondary fs-6 me-2">@Model.FieldType</span>
                    <span class="badge @(Model.Status == FootballPitchManagement.Models.Enums.FieldStatus.AVAILABLE ? "bg-success" : "bg-danger") fs-6">
                        @Model.Status
                    </span>
                    <p class="text-muted mt-2 mb-0"><i class="bi bi-geo-alt-fill text-danger"></i> @Model.Location</p>
                </div>
            </div>
            <hr />
            <p class="lead text-secondary">@Model.Description</p>
        </div>
    </div>
</div>

<!-- Date Selector -->
<div class="card shadow-sm border-0 mb-4">
    <div class="card-body p-3">
        <form method="get" asp-action="Details" asp-route-id="@Model.FieldId" class="row g-3 align-items-center">
            <input type="hidden" name="id" value="@Model.FieldId" />
            <div class="col-auto">
                <label class="col-form-label fw-bold">Select Date:</label>
            </div>
            <div class="col-auto">
                <input type="date" name="date" class="form-control" value="@searchDate.ToString("yyyy-MM-dd")" min="@DateTime.Today.ToString("yyyy-MM-dd")" onchange="this.form.submit()" />
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-outline-primary">Check Availability</button>
            </div>
        </form>
    </div>
</div>

<!-- Slots Grid -->
<div class="card shadow-sm border-0">
    <div class="card-header bg-white py-3">
        <h5 class="fw-bold mb-0">Time Slots for @searchDate.ToString("dddd, dd/MM/yyyy")</h5>
    </div>
    <div class="card-body">
        <div class="row g-3">
            @foreach (var slot in Model.Slots)
            {
                <div class="col-md-4">
                    <div class="border rounded p-3 @(slot.IsAvailable ? "border-success bg-white" : "border-light bg-light") h-100 d-flex flex-column justify-content-between shadow-sm">
                        <div>
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="fw-bold">@slot.SlotName</span>
                                <span class="badge @slot.BadgeClass">@slot.StatusDisplay</span>
                            </div>
                            <p class="text-muted small mb-2">
                                <i class="bi bi-clock"></i> @slot.StartTime.ToString(@"hh\:mm") - @slot.EndTime.ToString(@"hh\:mm")
                            </p>
                            <h5 class="text-success fw-bold">@slot.Price.ToString("N0") VND</h5>
                        </div>
                        <div class="mt-3">
                            @if (slot.IsAvailable)
                            {
                                <a asp-controller="Booking" asp-action="Create"
                                   asp-route-fieldId="@Model.FieldId"
                                   asp-route-slotId="@slot.SlotId"
                                   asp-route-date="@searchDate.ToString("yyyy-MM-dd")"
                                   class="btn btn-success w-100 fw-semibold">
                                    <i class="bi bi-calendar-plus"></i> Book Slot
                                </a>
                            }
                            else
                            {
                                <button class="btn btn-secondary w-100" disabled>Unavailable</button>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

