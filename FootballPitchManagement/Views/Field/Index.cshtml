@model FootballPitchManagement.Models.ViewModels.FieldSearchVM

@{
    ViewData["Title"] = "Tìm Kiếm Sân & Khung Giờ Thi Đấu";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1 text-dark"><i class="bi bi-calendar2-range text-success"></i> Đặt Sân Bóng Đá Trực Tuyến</h2>
        <p class="text-muted mb-0">Xem tình trạng sân theo thời gian thực và chọn khung giờ phù hợp cho đội của bạn</p>
    </div>
</div>

<!-- Bộ lọc tìm kiếm -->
<div class="card shadow-sm border-0 mb-4 rounded-4">
    <div class="card-body p-4 bg-white rounded-4">
        <form method="get" asp-action="Index" class="row g-3 align-items-end">
            <div class="col-md-3">
                <label class="form-label small fw-bold text-dark"><i class="bi bi-calendar-date text-primary me-1"></i> Ngày Thi Đấu</label>
                <input type="date" name="date" class="form-control form-control-lg" value="@Model.BookingDate.ToString("yyyy-MM-dd")" min="@DateTime.Today.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-bold text-dark"><i class="bi bi-grid text-primary me-1"></i> Cỡ Sân</label>
                <select name="fieldType" class="form-select form-select-lg">
                    <option value="">Tất cả các cỡ sân</option>
                    <option value="FIELD_5" selected="@(Model.FieldType == FootballPitchManagement.Models.Enums.FieldType.FIELD_5)">Sân 5 người</option>
                    <option value="FIELD_7" selected="@(Model.FieldType == FootballPitchManagement.Models.Enums.FieldType.FIELD_7)">Sân 7 người</option>
                    <option value="FIELD_11" selected="@(Model.FieldType == FootballPitchManagement.Models.Enums.FieldType.FIELD_11)">Sân 11 người</option>
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label small fw-bold text-dark"><i class="bi bi-search text-primary me-1"></i> Tên sân / Khu vực</label>
                <input type="text" name="keyword" class="form-control form-control-lg" value="@Model.Keyword" placeholder="Nhập tên sân hoặc khu vực..." />
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary btn-lg w-100 fw-bold shadow-sm">
                    <i class="bi bi-filter"></i> Lọc Sân
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Danh sách sân và các ca đá -->
@if (Model.Fields.Any())
{
    @foreach (var field in Model.Fields)
    {
        <div class="card shadow-sm border-0 mb-4 rounded-4 overflow-hidden">
            <div class="card-header bg-white py-3 px-4 border-0">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h4 class="fw-bold text-dark mb-1">
                            <i class="bi bi-geo-alt-fill text-danger me-1"></i> @field.Name
                        </h4>
                        <span class="badge bg-primary me-2">
                            @(field.FieldType == FootballPitchManagement.Models.Enums.FieldType.FIELD_5 ? "Sân 5" : (field.FieldType == FootballPitchManagement.Models.Enums.FieldType.FIELD_7 ? "Sân 7" : "Sân 11"))
                        </span>
                        <span class="text-muted small">@field.Location</span>
                    </div>
                    <div>
                        <span class="badge @(field.Status == FootballPitchManagement.Models.Enums.FieldStatus.AVAILABLE ? "bg-success" : "bg-danger") px-3 py-2">
                            @(field.Status == FootballPitchManagement.Models.Enums.FieldStatus.AVAILABLE ? "Đang hoạt động" : "Đang bảo trì")
                        </span>
                    </div>
                </div>
                @if (!string.IsNullOrEmpty(field.Description))
                {
                    <p class="text-muted small mt-2 mb-0">@field.Description</p>
                }
            </div>
            <div class="card-body px-4 pt-0 pb-4">
                <h6 class="fw-bold text-secondary mb-3">
                    <i class="bi bi-clock-history me-1"></i> Tình trạng ca đá ngày @Model.BookingDate.ToString("dd/MM/yyyy") (@(Model.BookingDate.DayOfWeek == DayOfWeek.Sunday ? "Chủ Nhật" : (Model.BookingDate.DayOfWeek == DayOfWeek.Saturday ? "Thứ Bảy" : "Thứ " + ((int)Model.BookingDate.DayOfWeek + 1)))):
                </h6>
                <div class="row g-3">
                    @if (field.Slots.Any())
                    {
                        @foreach (var slot in field.Slots)
                        {
                            <div class="col-lg-4 col-md-6">
                                <div class="border rounded-4 p-3 @(slot.IsAvailable ? "border-success bg-white shadow-sm" : "border-light bg-light") h-100 d-flex flex-column justify-content-between">
                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                        <div>
                                            <span class="fw-bold text-dark">@slot.SlotName</span>
                                            <div class="text-muted small mt-1">
                                                <i class="bi bi-clock me-1 text-primary"></i> @slot.StartTime.ToString(@"hh\:mm") - @slot.EndTime.ToString(@"hh\:mm")
                                            </div>
                                        </div>
                                        @{
                                            string vnStatus = slot.StatusDisplay switch
                                            {
                                                "Available" => "Còn trống",
                                                "Hold (15m)" => "Đang giữ chỗ",
                                                "In Use" => "Đang thi đấu",
                                                "Booked" => "Đã có người đặt",
                                                "Maintenance" => "Bảo trì",
                                                _ => slot.StatusDisplay
                                            };
                                        }
                                        <span class="badge @slot.BadgeClass">@vnStatus</span>
                                    </div>
                                    <div class="d-flex justify-content-between align-items-center mt-3 pt-2 border-top">
                                        <div class="fw-bold text-success fs-5">
                                            @slot.Price.ToString("N0") <span class="small fw-normal">đ</span>
                                        </div>
                                        @if (slot.IsAvailable)
                                        {
                                            <a asp-controller="Booking" asp-action="Create"
                                               asp-route-fieldId="@field.FieldId"
                                               asp-route-slotId="@slot.SlotId"
                                               asp-route-date="@Model.BookingDate.ToString("yyyy-MM-dd")"
                                               class="btn btn-success btn-sm px-3 fw-bold shadow-sm">
                                                Đặt Sân <i class="bi bi-arrow-right"></i>
                                            </a>
                                        }
                                        else
                                        {
                                            <button class="btn btn-secondary btn-sm px-3" disabled>
                                                Hết chỗ
                                            </button>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="col-12">
                            <p class="text-muted fst-italic">Chưa có cấu hình ca đá cho sân này.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
}
else
{
    <div class="alert alert-light text-center py-5 shadow-sm rounded-4 border">
        <i class="bi bi-info-circle display-4 text-primary"></i>
        <h4 class="mt-3 fw-bold">Không tìm thấy sân bóng phù hợp</h4>
        <p class="text-muted">Vui lòng thử chọn lại ngày thi đấu khác hoặc đổi kích thước sân.</p>
    </div>
}
