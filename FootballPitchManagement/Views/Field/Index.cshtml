@model FootballPitchManagement.Models.ViewModels.FieldSearchVM

@{
    ViewData["Title"] = "Search Football Fields & Slots";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1">Search Football Fields & Time Slots</h2>
        <p class="text-muted mb-0">Select date and pitch size to find available booking slots (UC06)</p>
    </div>
</div>

<!-- Search Filter Bar -->
<div class="card shadow-sm border-0 mb-4">
    <div class="card-body p-3">
        <form method="get" asp-action="Index" class="row g-3 align-items-end">
            <div class="col-md-3">
                <label class="form-label small fw-semibold">Match Date</label>
                <input type="date" name="date" class="form-control" value="@Model.BookingDate.ToString("yyyy-MM-dd")" min="@DateTime.Today.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-semibold">Field Type</label>
                <select name="fieldType" class="form-select">
                    <option value="">All Types</option>
                    <option value="FIELD_5" selected="@(Model.FieldType == FootballPitchManagement.Models.Enums.FieldType.FIELD_5)">5-a-side Mini Pitch</option>
                    <option value="FIELD_7" selected="@(Model.FieldType == FootballPitchManagement.Models.Enums.FieldType.FIELD_7)">7-a-side Pitch</option>
                    <option value="FIELD_11" selected="@(Model.FieldType == FootballPitchManagement.Models.Enums.FieldType.FIELD_11)">11-a-side Stadium</option>
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label small fw-semibold">Keywords</label>
                <input type="text" name="keyword" class="form-control" value="@Model.Keyword" placeholder="Search by name, location..." />
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary w-100 fw-semibold">
                    <i class="bi bi-filter"></i> Filter
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Fields & Slots Grid -->
@if (Model.Fields.Any())
{
    @foreach (var field in Model.Fields)
    {
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white py-3 border-0">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h4 class="fw-bold text-primary mb-1">
                            <i class="bi bi-geo-alt-fill text-danger"></i> @field.Name
                        </h4>
                        <span class="badge bg-secondary me-2">@field.FieldType</span>
                        <span class="text-muted small">@field.Location</span>
                    </div>
                    <div>
                        <span class="badge @(field.Status == FootballPitchManagement.Models.Enums.FieldStatus.AVAILABLE ? "bg-success" : "bg-danger") px-3 py-2">
                            Field: @field.Status
                        </span>
                    </div>
                </div>
                @if (!string.IsNullOrEmpty(field.Description))
                {
                    <p class="text-muted small mt-2 mb-0">@field.Description</p>
                }
            </div>
            <div class="card-body pt-0">
                <h6 class="fw-bold text-muted mb-3">Time Slots for @Model.BookingDate.ToString("dddd, dd/MM/yyyy"):</h6>
                <div class="row g-2">
                    @if (field.Slots.Any())
                    {
                        @foreach (var slot in field.Slots)
                        {
                            <div class="col-lg-4 col-md-6">
                                <div class="border rounded p-3 @(slot.IsAvailable ? "border-success bg-white" : "border-light bg-light") h-100 d-flex flex-column justify-content-between">
                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                        <div>
                                            <span class="fw-bold text-dark">@slot.SlotName</span>
                                            <div class="text-muted small">
                                                <i class="bi bi-clock"></i> @slot.StartTime.ToString(@"hh\:mm") - @slot.EndTime.ToString(@"hh\:mm")
                                            </div>
                                        </div>
                                        <span class="badge @slot.BadgeClass">@slot.StatusDisplay</span>
                                    </div>
                                    <div class="d-flex justify-content-between align-items-center mt-2">
                                        <div class="fw-bold text-success fs-6">
                                            @slot.Price.ToString("N0") VND
                                        </div>
                                        @if (slot.IsAvailable)
                                        {
                                            <a asp-controller="Booking" asp-action="Create"
                                               asp-route-fieldId="@field.FieldId"
                                               asp-route-slotId="@slot.SlotId"
                                               asp-route-date="@Model.BookingDate.ToString("yyyy-MM-dd")"
                                               class="btn btn-success btn-sm px-3 fw-semibold">
                                                Book Now <i class="bi bi-arrow-right-short"></i>
                                            </a>
                                        }
                                        else
                                        {
                                            <button class="btn btn-secondary btn-sm px-3" disabled>
                                                Unavailable
                                            </button>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="col-12">
                            <p class="text-muted fst-italic">No time slots configured for this field.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
}
else
{
    <div class="alert alert-info text-center py-5 shadow-sm">
        <i class="bi bi-info-circle display-4 text-info"></i>
        <h4 class="mt-3">No football fields match your criteria</h4>
        <p class="text-muted">Please adjust the search filter date or field size.</p>
    </div>
}

