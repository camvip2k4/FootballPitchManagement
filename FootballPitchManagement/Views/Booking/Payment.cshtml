@model FootballPitchManagement.Models.ViewModels.MakePaymentVM

@{
    ViewData["Title"] = "Thanh Toán Đặt Sân - Cổng VietQR & VNPAY";
}

<div class="row justify-content-center">
    <div class="col-lg-8 col-md-10">
        <div class="card shadow border-0 rounded-4 overflow-hidden">
            <div class="card-header bg-dark text-white py-3 px-4 d-flex justify-content-between align-items-center">
                <h4 class="mb-0 fw-bold d-flex align-items-center">
                    <i class="bi bi-qr-code text-warning me-2"></i> Thanh Toán & Xác Nhận Đặt Sân
                </h4>
                <span class="badge bg-primary fs-6 px-3 py-2">Mã đơn: @Model.BookingCode</span>
            </div>
            <div class="card-body p-4">
                <!-- Đồng hồ đếm ngược giữ chỗ -->
                <div class="alert alert-info border-0 rounded-3 d-flex justify-content-between align-items-center mb-4 bg-primary bg-opacity-10">
                    <div class="d-flex align-items-center">
                        <i class="bi bi-hourglass-split fs-2 me-3 text-primary"></i>
                        <div>
                            <strong class="text-dark d-block">Thời Gian Tạm Giữ Chỗ Đang Đếm Ngược</strong>
                            <span class="small text-muted">Ca đá được bảo lưu độc quyền cho bạn trong 15 phút.</span>
                        </div>
                    </div>
                    <div class="text-end">
                        <span class="badge bg-warning text-dark px-3 py-2 fw-bold" id="holdStatus">
                            Hết hạn: @Model.HoldExpiresAt.ToString("HH:mm:ss") UTC
                        </span>
                    </div>
                </div>

                <!-- Tóm tắt chi phí -->
                <div class="card bg-light border-0 rounded-3 mb-4">
                    <div class="card-body p-3">
                        <div class="row text-center g-2">
                            <div class="col-sm-4 border-end">
                                <span class="text-muted small">Sân thi đấu</span>
                                <h6 class="fw-bold text-dark mt-1">@Model.FieldName</h6>
                                <small class="text-muted">@Model.SlotName</small>
                            </div>
                            <div class="col-sm-4 border-end">
                                <span class="text-muted small">Tổng tiền ca đá</span>
                                <h5 class="fw-bold text-dark mt-1">@Model.AgreedPrice.ToString("N0") đ</h5>
                                <small class="text-muted">Ngày: @Model.BookingDate.ToString("dd/MM/yyyy")</small>
                            </div>
                            <div class="col-sm-4">
                                <span class="text-muted small">Tiền cọc cần thanh toán</span>
                                <h4 class="fw-bold text-success mt-1">@Model.RequiredPrepayment.ToString("N0") đ</h4>
                                <small class="text-success fw-semibold">Đã thanh toán: @Model.PaidAmount.ToString("N0") đ</small>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Form phương thức thanh toán -->
                <form asp-action="Payment" method="post">
                    <input type="hidden" asp-for="BookingId" />
                    <input type="hidden" asp-for="BookingCode" />

                    <!-- Tab chọn phương thức -->
                    <h5 class="fw-bold text-dark mb-3"><i class="bi bi-credit-card me-1 text-primary"></i> Chọn Phương Thức Thanh Toán</h5>
                    
                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <div class="border rounded-3 p-3 bg-white h-100 shadow-sm border-2 border-primary">
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" asp-for="Method" value="ONLINE_GATEWAY" id="methodVietQR" checked>
                                    <label class="form-check-label fw-bold text-dark" for="methodVietQR">
                                        <i class="bi bi-qr-code text-success me-1"></i> Quét mã VietQR / Chuyển khoản Ngân hàng
                                    </label>
                                </div>
                                <div class="mt-3 p-3 bg-light rounded text-center">
                                    <div class="p-2 bg-white d-inline-block border rounded mb-2">
                                        <img src="https://api.qrserver.com/v1/create-qr-code/?size=160x160&data=SPORTARENA-@Model.BookingCode" alt="Mã VietQR" class="img-fluid" style="width: 140px; height: 140px;" />
                                    </div>
                                    <p class="small text-muted mb-1">Ngân hàng: <strong>MBBank (Quân Đội)</strong></p>
                                    <p class="small text-muted mb-1">Số TK: <strong>0987654321</strong> - CTK: <strong>SPORT ARENA</strong></p>
                                    <p class="small text-danger fw-bold mb-0">Nội dung CK: @Model.BookingCode</p>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="border rounded-3 p-3 bg-white h-100 shadow-sm">
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" asp-for="Method" value="ONLINE_GATEWAY" id="methodVNPAY">
                                    <label class="form-check-label fw-bold text-dark" for="methodVNPAY">
                                        <i class="bi bi-wallet2 text-primary me-1"></i> Cổng VNPAY / Thẻ ATM / Visa
                                    </label>
                                </div>
                                <div class="mt-3 text-muted small p-2">
                                    <p>Hỗ trợ hơn 40 ngân hàng nội địa Việt Nam, ví VNPAY, Viettel Money, thẻ Visa/Mastercard.</p>
                                    <div class="d-flex gap-2 fs-3 text-primary">
                                        <i class="bi bi-credit-card-fill"></i>
                                        <i class="bi bi-phone-fill text-success"></i>
                                        <i class="bi bi-shield-lock-fill text-dark"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-bold">Số tiền thanh toán xác nhận (VND):</label>
                        <input asp-for="PaymentAmount" class="form-control form-control-lg fw-bold text-success" />
                        <small class="text-muted">Số tiền tối thiểu cần thanh toán để xác nhận giữ sân: @Model.RequiredPrepayment.ToString("N0") đ</small>
                    </div>

                    <div class="d-grid gap-2 mb-4">
                        <button type="submit" class="btn btn-success btn-lg fw-bold py-3 shadow">
                            <i class="bi bi-check-circle-fill me-1"></i> Xác Nhận Đã Thanh Toán Thành Công
                        </button>
                        <a asp-action="MyBookings" class="btn btn-outline-secondary py-2">
                            Thanh toán sau (Quay lại danh sách đơn)
                        </a>
                    </div>

                    <!-- Panel mô phỏng kiểm thử kỹ thuật (Được thu gọn thanh lịch) -->
                    <div class="accordion" id="devAccordion">
                        <div class="accordion-item border-warning rounded">
                            <h2 class="accordion-header" id="headingDev">
                                <button class="accordion-button collapsed bg-warning bg-opacity-10 text-dark py-2 small fw-semibold" type="button" data-bs-toggle="collapse" data-bs-target="#collapseDev" aria-expanded="false" aria-controls="collapseDev">
                                    <i class="bi bi-tools text-warning me-2"></i> Tùy chọn kiểm thử cổng thanh toán (Test Sandbox Kịch Bản)
                                </button>
                            </h2>
                            <div id="collapseDev" class="accordion-collapse collapse" aria-labelledby="headingDev" data-bs-parent="#devAccordion">
                                <div class="accordion-body bg-light small">
                                    <div class="mb-2">
                                        <label class="form-label fw-bold">Kịch bản phản hồi từ cổng thanh toán:</label>
                                        <select asp-for="SimulatedResult" class="form-select form-select-sm">
                                            <option value="SUCCESS">Thành công (SUCCESS) - Đơn được xác nhận ngay</option>
                                            <option value="FAILED">Thất bại (FAILED) - Báo lỗi giao dịch</option>
                                            <option value="PENDING">Chờ xử lý (PENDING / TIMEOUT) - Chưa xác nhận</option>
                                        </select>
                                    </div>
                                    <div class="form-check mt-2">
                                        <input asp-for="SimulateLatePayment" class="form-check-input" type="checkbox" id="lateCheck" />
                                        <label class="form-check-label text-danger fw-semibold" for="lateCheck">
                                            Giả lập thanh toán muộn (Tiền về sau khi hết 15p giữ chỗ: Sân tự động tạo yêu cầu hoàn tiền 100%)
                                        </label>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
