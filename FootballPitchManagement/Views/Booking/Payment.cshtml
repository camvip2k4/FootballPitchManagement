@model FootballPitchManagement.Models.ViewModels.MakePaymentVM

@{
    ViewData["Title"] = "Make Payment (UC14)";
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-success text-white py-3">
                <div class="d-flex justify-content-between align-items-center">
                    <h4 class="mb-0"><i class="bi bi-credit-card-2-front"></i> Online Payment Gateway (UC14)</h4>
                    <span class="badge bg-light text-dark">@Model.BookingCode</span>
                </div>
            </div>
            <div class="card-body p-4">
                <!-- Hold countdown timer box -->
                <div class="alert alert-info d-flex justify-content-between align-items-center mb-4">
                    <div>
                        <i class="bi bi-alarm-fill fs-4 me-2 text-primary"></i>
                        <strong>Slot Hold Status:</strong>
                        <span class="badge bg-warning text-dark ms-2">@Model.BookingStatus</span>
                    </div>
                    <div class="text-end">
                        <small class="text-muted d-block">Hold Expires At (UTC):</small>
                        <span class="fw-bold text-danger">@Model.HoldExpiresAt.ToString("yyyy-MM-dd HH:mm:ss")</span>
                    </div>
                </div>

                <!-- Booking info card -->
                <div class="card bg-light border-0 mb-4">
                    <div class="card-body">
                        <div class="row mb-2">
                            <div class="col-sm-4 text-muted">Field & Slot:</div>
                            <div class="col-sm-8 fw-bold">@Model.FieldName - @Model.SlotName</div>
                        </div>
                        <div class="row mb-2">
                            <div class="col-sm-4 text-muted">Match Date:</div>
                            <div class="col-sm-8">@Model.BookingDate.ToString("dddd, dd/MM/yyyy")</div>
                        </div>
                        <div class="row mb-2">
                            <div class="col-sm-4 text-muted">Agreed Price:</div>
                            <div class="col-sm-8 fw-bold">@Model.AgreedPrice.ToString("N0") VND</div>
                        </div>
                        <div class="row mb-2">
                            <div class="col-sm-4 text-muted">Required Deposit:</div>
                            <div class="col-sm-8 fw-bold text-primary">@Model.RequiredPrepayment.ToString("N0") VND</div>
                        </div>
                        <div class="row">
                            <div class="col-sm-4 text-muted">Amount Already Paid:</div>
                            <div class="col-sm-8 text-success fw-bold">@Model.PaidAmount.ToString("N0") VND</div>
                        </div>
                    </div>
                </div>

                <!-- Payment Execution Form -->
                <form asp-action="Payment" method="post">
                    <input type="hidden" asp-for="BookingId" />
                    <input type="hidden" asp-for="BookingCode" />

                    <div class="mb-3">
                        <label class="form-label fw-bold">Amount to Pay Now (VND)</label>
                        <input asp-for="PaymentAmount" class="form-control form-control-lg fw-bold text-success" />
                        <small class="text-muted">Minimum deposit to confirm: @Model.RequiredPrepayment.ToString("N0") VND</small>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-bold">Payment Method</label>
                        <select asp-for="Method" class="form-select">
                            <option value="ONLINE_GATEWAY">Online Gateway (VNPAY / ATM / Credit Card)</option>
                            <option value="BANK_TRANSFER">Direct QR Bank Transfer</option>
                        </select>
                    </div>

                    <!-- Payment Provider Simulation Sandbox (For Testing UC14 Requirements) -->
                    <div class="card border-warning mb-4">
                        <div class="card-header bg-warning text-dark py-2">
                            <i class="bi bi-toggles2"></i> <strong>Gateway Provider Simulation (UC14 Testing):</strong>
                        </div>
                        <div class="card-body">
                            <div class="mb-3">
                                <label class="form-label small fw-semibold">Simulate Transaction Result:</label>
                                <select asp-for="SimulatedResult" class="form-select form-select-sm">
                                    <option value="SUCCESS">SUCCESS (Normal Verified Payment -> Confirmed)</option>
                                    <option value="FAILED">FAILED (Gateway Payment Failure -> Status Payment Failed)</option>
                                    <option value="PENDING">PENDING / TIMEOUT (Unknown Gateway Status -> Remains Pending)</option>
                                </select>
                            </div>
                            <div class="form-check">
                                <input asp-for="SimulateLatePayment" class="form-check-input" type="checkbox" id="lateCheck" />
                                <label class="form-check-label small" for="lateCheck">
                                    <strong>Simulate Late Payment:</strong> Simulates money arriving after 15-min hold expired (Triggers automatic 100% RefundRequest creation per UC14!).
                                </label>
                            </div>
                        </div>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-success btn-lg fw-semibold py-3 shadow-sm">
                            <i class="bi bi-check2-circle"></i> Submit Payment
                        </button>
                        <a asp-action="MyBookings" class="btn btn-outline-secondary">Pay Later / Back to My Bookings</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

