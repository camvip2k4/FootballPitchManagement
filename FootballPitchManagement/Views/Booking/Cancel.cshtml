@model FootballPitchManagement.Models.ViewModels.CancelBookingVM

@{
    ViewData["Title"] = "Cancel Booking (UC13)";
    var booking = (FootballPitchManagement.Models.Entities.Booking)ViewBag.Booking;
    int cutoffHours = (int)ViewBag.CutoffHours;
    int refundPercent = (int)ViewBag.RefundPercent;
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow-sm border-danger">
            <div class="card-header bg-danger text-white py-3">
                <h4 class="mb-0"><i class="bi bi-x-octagon"></i> Cancel Booking (UC13)</h4>
            </div>
            <div class="card-body p-4">
                <div class="alert alert-warning mb-4">
                    <h6 class="fw-bold"><i class="bi bi-exclamation-triangle"></i> Cancellation Policy (POL-03):</h6>
                    <p class="small mb-1">
                        - Customer cancellation must be requested at least <strong>@cutoffHours hours</strong> before the scheduled match start time.
                    </p>
                    <p class="small mb-0">
                        - Eligible cancellations will receive a <strong>@refundPercent% refund</strong> of any paid amount, automatically queued for review.
                    </p>
                </div>

                <div class="card bg-light border-0 mb-4">
                    <div class="card-body">
                        <div class="row mb-2">
                            <div class="col-sm-4 text-muted">Booking Code:</div>
                            <div class="col-sm-8 fw-bold">@booking.BookingCode</div>
                        </div>
                        <div class="row mb-2">
                            <div class="col-sm-4 text-muted">Field:</div>
                            <div class="col-sm-8">@booking.Field?.Name</div>
                        </div>
                        <div class="row mb-2">
                            <div class="col-sm-4 text-muted">Match Date:</div>
                            <div class="col-sm-8">@booking.BookingDate.ToString("dd/MM/yyyy") (@booking.TimeSlot?.SlotName)</div>
                        </div>
                        <div class="row mb-2">
                            <div class="col-sm-4 text-muted">Paid Amount:</div>
                            <div class="col-sm-8 text-success fw-bold">@booking.PaidAmount.ToString("N0") VND</div>
                        </div>
                        <div class="row">
                            <div class="col-sm-4 text-muted">Estimated Refund:</div>
                            <div class="col-sm-8 fw-bold text-primary">
                                @((booking.PaidAmount * refundPercent / 100m).ToString("N0")) VND (@refundPercent%)
                            </div>
                        </div>
                    </div>
                </div>

                <form asp-action="Cancel" method="post">
                    <input type="hidden" asp-for="BookingId" />
                    <input type="hidden" asp-for="BookingCode" />

                    <div class="mb-3">
                        <label asp-for="Reason" class="form-label fw-bold">Please specify your cancellation reason:</label>
                        <textarea asp-for="Reason" class="form-control" rows="3" placeholder="e.g. Schedule conflict, bad weather, injured players..."></textarea>
                        <span asp-validation-for="Reason" class="text-danger"></span>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-danger btn-lg fw-semibold py-2">
                            <i class="bi bi-trash"></i> Confirm Cancellation
                        </button>
                        <a asp-action="MyBookings" class="btn btn-outline-secondary">Back to My Bookings</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

