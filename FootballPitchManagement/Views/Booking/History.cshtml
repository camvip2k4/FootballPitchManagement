@model IEnumerable<FootballPitchManagement.Models.Entities.Booking>

@{
    ViewData["Title"] = "Tra Cứu Lịch Sử Đặt Sân";
}

<div class="container mt-2">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2 class="fw-bold mb-1 text-dark"><i class="bi bi-clock-history text-primary"></i> Tra Cứu Lịch Sử Đặt Sân</h2>
            <p class="text-muted mb-0">Tra cứu nhanh toàn bộ lịch sử thi đấu bằng số điện thoại khách hàng</p>
        </div>
    </div>

    <!-- Form tra cứu theo số điện thoại -->
    <div class="card shadow-sm border-0 mb-4 rounded-4">
        <div class="card-body p-4 bg-white rounded-4">
            <form method="get" asp-action="History" class="row g-2 align-items-center">
                <div class="col-md-6">
                    <label class="form-label small fw-bold text-dark">Số điện thoại đặt sân:</label>
                    <div class="input-group input-group-lg">
                        <span class="input-group-text bg-light"><i class="bi bi-telephone text-primary"></i></span>
                        <input type="text" class="form-control" name="phone" value="@ViewBag.Phone" placeholder="Ví dụ: 0987654321..." />
                        <button type="submit" class="btn btn-primary px-4 fw-bold">Tìm Kiếm</button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="table-responsive bg-white rounded-4 shadow-sm p-3">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Mã Đơn</th>
                        <th>Sân Bóng</th>
                        <th>Ca Đá / Ngày</th>
                        <th>Khách Hàng</th>
                        <th>Tổng Tiền</th>
                        <th>Đã Thu</th>
                        <th>Còn Thiếu</th>
                        <th>Trạng Thái</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-bold text-primary">@item.BookingCode</td>
                            <td class="fw-bold text-dark">@(item.Field?.Name ?? $"Sân #{item.FieldId}")</td>
                            <td>
                                <div class="fw-semibold">@item.BookingDate.ToString("dd/MM/yyyy")</div>
                                <small class="text-muted">@(item.TimeSlot?.SlotName ?? "Ca đá")</small>
                            </td>
                            <td>
                                <div>@(item.Account?.FullName ?? item.GuestName ?? "Khách vãng lai")</div>
                                <small class="text-muted">@(item.Account?.Phone ?? item.GuestPhone)</small>
                            </td>
                            <td>@item.AgreedPrice.ToString("N0") đ</td>
                            <td class="text-success fw-bold">@item.PaidAmount.ToString("N0") đ</td>
                            <td class="@(item.BalanceDue > 0 ? "text-danger fw-bold" : "text-muted")">
                                @item.BalanceDue.ToString("N0") đ
                            </td>
                            <td>
                                @{
                                    (string badge, string text) = item.Status switch
                                    {
                                        FootballPitchManagement.Models.Enums.BookingStatus.CONFIRMED => ("bg-success", "Đã xác nhận"),
                                        FootballPitchManagement.Models.Enums.BookingStatus.CHECKED_IN => ("bg-info text-dark", "Đang thi đấu"),
                                        FootballPitchManagement.Models.Enums.BookingStatus.PENDING_PAYMENT => ("bg-warning text-dark", "Chờ đặt cọc"),
                                        FootballPitchManagement.Models.Enums.BookingStatus.COMPLETED => ("bg-primary", "Đã hoàn thành"),
                                        FootballPitchManagement.Models.Enums.BookingStatus.CANCELLED => ("bg-secondary", "Đã hủy"),
                                        FootballPitchManagement.Models.Enums.BookingStatus.EXPIRED => ("bg-dark", "Hết hạn"),
                                        FootballPitchManagement.Models.Enums.BookingStatus.NO_SHOW => ("bg-danger", "Vắng mặt"),
                                        _ => ("bg-secondary", item.Status.ToString())
                                    };
                                }
                                <span class="badge @badge px-2 py-1">@text</span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(ViewBag.Phone))
    {
        <div class="alert alert-light text-center py-5 shadow-sm rounded-4 border">
            <i class="bi bi-search display-4 text-muted"></i>
            <h5 class="mt-3 fw-bold">Không tìm thấy thông tin</h5>
            <p class="text-muted mb-0">Không có đơn đặt sân nào gắn với số điện thoại: <strong>@ViewBag.Phone</strong></p>
        </div>
    }
</div>
