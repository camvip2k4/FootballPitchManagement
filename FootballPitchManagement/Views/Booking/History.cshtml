@model IEnumerable<FootballPitchManagement.Models.Entities.Booking>

@{
    ViewData["Title"] = "Customer Booking History";
}

<div class="container mt-2">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2 class="fw-bold mb-1"><i class="bi bi-clock-history"></i> Booking History Lookup</h2>
            <p class="text-muted mb-0">Search booking records by customer phone number</p>
        </div>
    </div>

    <!-- Phone search form -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body p-3">
            <form method="get" asp-action="History" class="row g-2 align-items-center">
                <div class="col-md-6">
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-phone"></i></span>
                        <input type="text" class="form-control" name="phone" value="@ViewBag.Phone" placeholder="Enter customer phone number (e.g. 0987654321)..." />
                        <button type="submit" class="btn btn-primary px-4">Search</button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="table-responsive bg-white rounded shadow-sm p-3">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Booking Code</th>
                        <th>Pitch</th>
                        <th>Slot / Date</th>
                        <th>Customer</th>
                        <th>Price</th>
                        <th>Paid</th>
                        <th>Balance</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-bold text-primary">@item.BookingCode</td>
                            <td class="fw-semibold">@(item.Field?.Name ?? $"Field #{item.FieldId}")</td>
                            <td>
                                <div>@item.BookingDate.ToString("dd/MM/yyyy")</div>
                                <small class="text-muted">@(item.TimeSlot?.SlotName ?? "Slot")</small>
                            </td>
                            <td>
                                <div>@(item.Account?.FullName ?? item.GuestName ?? "Guest")</div>
                                <small class="text-muted">@(item.Account?.Phone ?? item.GuestPhone)</small>
                            </td>
                            <td>@item.AgreedPrice.ToString("N0") VND</td>
                            <td class="text-success fw-bold">@item.PaidAmount.ToString("N0") VND</td>
                            <td class="@(item.BalanceDue > 0 ? "text-danger fw-bold" : "text-muted")">
                                @item.BalanceDue.ToString("N0") VND
                            </td>
                            <td>
                                @{
                                    string badge = item.Status switch
                                    {
                                        FootballPitchManagement.Models.Enums.BookingStatus.CONFIRMED => "bg-success",
                                        FootballPitchManagement.Models.Enums.BookingStatus.CHECKED_IN => "bg-info text-dark",
                                        FootballPitchManagement.Models.Enums.BookingStatus.PENDING_PAYMENT => "bg-warning text-dark",
                                        FootballPitchManagement.Models.Enums.BookingStatus.COMPLETED => "bg-primary",
                                        FootballPitchManagement.Models.Enums.BookingStatus.CANCELLED => "bg-secondary",
                                        FootballPitchManagement.Models.Enums.BookingStatus.EXPIRED => "bg-dark",
                                        FootballPitchManagement.Models.Enums.BookingStatus.NO_SHOW => "bg-danger",
                                        _ => "bg-secondary"
                                    };
                                }
                                <span class="badge @badge">@item.Status</span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(ViewBag.Phone))
    {
        <div class="alert alert-warning text-center py-4 shadow-sm">
            <i class="bi bi-search fs-2"></i>
            <p class="mt-2 mb-0">No booking records found for phone number: <strong>@ViewBag.Phone</strong></p>
        </div>
    }
</div>
