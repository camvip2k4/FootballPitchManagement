@{
    ViewData["Title"] = "Confirm Booking Hold (UC10)";
    var field = (FootballPitchManagement.Models.Entities.FootballField)ViewBag.Field;
    var slot = (FootballPitchManagement.Models.Entities.TimeSlot)ViewBag.Slot;
    var bookingDate = (DateTime)ViewBag.BookingDate;
    decimal price = (decimal)ViewBag.Price;
    int depositPercent = (int)ViewBag.DepositPercent;
    decimal requiredPrepayment = (decimal)ViewBag.RequiredPrepayment;
    int holdMinutes = (int)ViewBag.HoldMinutes;
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-primary text-white py-3">
                <h4 class="mb-0"><i class="bi bi-calendar-check"></i> Confirm Football Field Booking</h4>
            </div>
            <div class="card-body p-4">
                <div class="alert alert-warning d-flex align-items-center mb-4" role="alert">
                    <i class="bi bi-stopwatch-fill fs-3 me-3 text-warning"></i>
                    <div>
                        <strong>15-Minute Slot Hold Policy (POL-02):</strong>
                        <p class="mb-0 small">
                            Upon clicking <strong>"Create Booking Hold"</strong>, this slot will be locked exclusively for you for <strong>@holdMinutes minutes</strong>.
                            You will proceed to make the deposit prepayment of <strong>@depositPercent%</strong> to confirm the reservation.
                        </p>
                    </div>
                </div>

                <div class="card bg-light border-0 mb-4">
                    <div class="card-body">
                        <h5 class="fw-bold text-dark border-bottom pb-2 mb-3">Booking Details Summary</h5>
                        <div class="row mb-2">
                            <div class="col-sm-4 text-muted">Field:</div>
                            <div class="col-sm-8 fw-bold">@field.Name (@field.FieldType)</div>
                        </div>
                        <div class="row mb-2">
                            <div class="col-sm-4 text-muted">Location:</div>
                            <div class="col-sm-8">@field.Location</div>
                        </div>
                        <div class="row mb-2">
                            <div class="col-sm-4 text-muted">Match Date:</div>
                            <div class="col-sm-8 fw-bold text-primary">@bookingDate.ToString("dddd, dd/MM/yyyy")</div>
                        </div>
                        <div class="row mb-2">
                            <div class="col-sm-4 text-muted">Time Slot:</div>
                            <div class="col-sm-8 fw-bold">@slot.SlotName (@slot.StartTime.ToString(@"hh\:mm") - @slot.EndTime.ToString(@"hh\:mm"))</div>
                        </div>
                        <hr />
                        <div class="row mb-2">
                            <div class="col-sm-4 text-muted">Total Agreed Price:</div>
                            <div class="col-sm-8 fs-5 fw-bold text-dark">@price.ToString("N0") VND</div>
                        </div>
                        <div class="row mb-2">
                            <div class="col-sm-4 text-muted">Deposit Required (@depositPercent%):</div>
                            <div class="col-sm-8 fs-5 fw-bold text-success">@requiredPrepayment.ToString("N0") VND</div>
                        </div>
                        <div class="row">
                            <div class="col-sm-4 text-muted">Remaining Balance:</div>
                            <div class="col-sm-8 text-secondary">@((price - requiredPrepayment).ToString("N0")) VND (pay upon arrival or check-out)</div>
                        </div>
                    </div>
                </div>

                <form asp-action="Create" method="post">
                    <input type="hidden" name="fieldId" value="@field.FieldId" />
                    <input type="hidden" name="slotId" value="@slot.SlotId" />
                    <input type="hidden" name="bookingDate" value="@bookingDate.ToString("yyyy-MM-dd")" />

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-success btn-lg fw-semibold py-3 shadow-sm">
                            <i class="bi bi-lock-fill"></i> Create Booking Hold & Proceed to Payment
                        </button>
                        <a asp-controller="Field" asp-action="Details" asp-route-id="@field.FieldId" asp-route-date="@bookingDate.ToString("yyyy-MM-dd")" class="btn btn-outline-secondary">
                            Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
