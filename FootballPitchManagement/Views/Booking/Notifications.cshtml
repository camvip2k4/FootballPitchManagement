@model IEnumerable<FootballPitchManagement.Models.Entities.Notification>

@{
    ViewData["Title"] = "Hộp Thư Thông Báo";
}

<div class="row justify-content-center">
    <div class="col-lg-8 col-md-10">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h3 class="fw-bold mb-0 text-dark"><i class="bi bi-bell-fill text-warning me-2"></i> Thông Báo Của Bạn</h3>
            <span class="badge bg-primary fs-6 px-3 py-2">@Model.Count(n => !n.IsRead) Chưa đọc</span>
        </div>

        @if (Model != null && Model.Any())
        {
            <div class="list-group shadow-sm border-0">
                @foreach (var n in Model)
                {
                    <div class="list-group-item list-group-item-action @(!n.IsRead ? "bg-white border-start border-4 border-primary shadow-sm" : "bg-light") p-3 mb-2 rounded-3">
                        <div class="d-flex w-100 justify-content-between align-items-center mb-1">
                            <h6 class="mb-0 fw-bold text-dark">
                                <i class="bi bi-info-circle-fill text-primary me-2"></i> @n.Type
                            </h6>
                            <small class="text-muted">@n.CreatedAt.ToString("dd/MM/yyyy HH:mm")</small>
                        </div>
                        <p class="mb-2 text-secondary small">@n.Message</p>
                        @if (!n.IsRead)
                        {
                            <form asp-action="MarkNotificationRead" asp-route-id="@n.NotificationId" method="post" class="d-inline">
                                <button type="submit" class="btn btn-outline-primary btn-sm py-0 px-2 small">
                                    <i class="bi bi-check2"></i> Đánh dấu đã đọc
                                </button>
                            </form>
                        }
                    </div>
                }
            </div>
        }
        else
        {
            <div class="alert alert-light text-center py-5 border rounded-4 shadow-sm">
                <i class="bi bi-bell-slash display-4 text-muted"></i>
                <h5 class="mt-3 fw-bold">Không có thông báo mới</h5>
                <p class="text-muted">Bạn chưa có tin nhắn hoặc thông báo nào vào lúc này.</p>
            </div>
        }
    </div>
</div>
