@model IEnumerable<FootballPitchManagement.Models.Entities.Booking>

@{
    ViewData["Title"] = "Lịch Đặt Sân Của Tôi";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1 text-dark"><i class="bi bi-receipt text-primary"></i> Đơn Đặt Sân Của Tôi</h2>
        <p class="text-muted mb-0">Theo dõi tiến độ, tình trạng thanh toán và quản lý lịch thi đấu của bạn</p>
    </div>
    <a asp-controller="Field" asp-action="Index" class="btn btn-success fw-bold px-4 py-2 shadow-sm">
        <i class="bi bi-plus-circle me-1"></i> Đặt Thêm Sân Mới
    </a>
</div>

@if (Model != null && Model.Any())
{
    <div class="table-responsive bg-white rounded-4 shadow-sm p-3">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Mã Đơn</th>
                    <th>Sân Thi Đấu & Ca Đá</th>
                    <th>Ngày Đá</th>
                    <th>Tổng Tiền</th>
                    <th>Đã Thanh Toán</th>
                    <th>Số Dư Còn Lại</th>
                    <th>Trạng Thái</th>
                    <th class="text-center">Thao Tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="fw-bold text-primary">@item.BookingCode</td>
                        <td>
                            <div class="fw-bold text-dark">@(item.Field?.Name ?? $"Sân #{item.FieldId}")</div>
                            <small class="text-muted"><i class="bi bi-clock me-1"></i> @(item.TimeSlot?.SlotName ?? "Ca đá")</small>
                        </td>
                        <td>
                            <span class="fw-semibold">@item.BookingDate.ToString("dd/MM/yyyy")</span>
                        </td>
                        <td class="fw-bold">@item.AgreedPrice.ToString("N0") đ</td>
                        <td class="text-success fw-bold">@item.PaidAmount.ToString("N0") đ</td>
                        <td class="@(item.BalanceDue > 0 ? "text-danger fw-bold" : "text-muted")">
                            @item.BalanceDue.ToString("N0") đ
                        </td>
                        <td>
                            @{
                                (string badge, string text) = item.Status switch
                                {
                                    FootballPitchManagement.Models.Enums.BookingStatus.CONFIRMED => ("bg-success", "Đã xác nhận"),
                                    FootballPitchManagement.Models.Enums.BookingStatus.CHECKED_IN => ("bg-info text-dark", "Đang thi đấu"),
                                    FootballPitchManagement.Models.Enums.BookingStatus.PENDING_PAYMENT => ("bg-warning text-dark", "Chờ đặt cọc"),
                                    FootballPitchManagement.Models.Enums.BookingStatus.COMPLETED => ("bg-primary", "Đã hoàn thành"),
                                    FootballPitchManagement.Models.Enums.BookingStatus.CANCELLED => ("bg-secondary", "Đã hủy"),
                                    FootballPitchManagement.Models.Enums.BookingStatus.EXPIRED => ("bg-dark", "Hết hạn giữ chỗ"),
                                    FootballPitchManagement.Models.Enums.BookingStatus.NO_SHOW => ("bg-danger", "Vắng mặt"),
                                    _ => ("bg-secondary", item.Status.ToString())
                                };
                            }
                            <span class="badge @badge px-3 py-2">@text</span>
                            @if (item.Status == FootballPitchManagement.Models.Enums.BookingStatus.PENDING_PAYMENT && item.HoldExpiresAt > DateTime.UtcNow)
                            {
                                <small class="d-block text-warning fw-semibold mt-1">
                                    Giữ chỗ đến: @item.HoldExpiresAt.ToString("HH:mm:ss")
                                </small>
                            }
                        </td>
                        <td class="text-center">
                            <div class="d-flex gap-2 justify-content-center flex-wrap">
                                @if (item.Status == FootballPitchManagement.Models.Enums.BookingStatus.PENDING_PAYMENT ||
                                     item.Status == FootballPitchManagement.Models.Enums.BookingStatus.PAYMENT_FAILED)
                                {
                                    <a asp-action="Payment" asp-route-id="@item.BookingId" class="btn btn-sm btn-success fw-bold">
                                        <i class="bi bi-credit-card me-1"></i> Thanh Toán Cọc
                                    </a>
                                }
                                @if (item.Status == FootballPitchManagement.Models.Enums.BookingStatus.CONFIRMED ||
                                     item.Status == FootballPitchManagement.Models.Enums.BookingStatus.PENDING_PAYMENT)
                                {
                                    <a asp-action="Cancel" asp-route-id="@item.BookingId" class="btn btn-sm btn-outline-danger">
                                        <i class="bi bi-x-circle me-1"></i> Hủy Đặt Sân
                                    </a>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="alert alert-light text-center py-5 rounded-4 shadow-sm border">
        <i class="bi bi-calendar-x display-4 text-muted"></i>
        <h5 class="mt-3 fw-bold">Bạn chưa có đơn đặt sân nào</h5>
        <p class="text-muted">Hãy lựa chọn khung giờ phù hợp và đặt sân cho trận cầu sắp tới của bạn.</p>
        <a asp-controller="Field" asp-action="Index" class="btn btn-success fw-bold px-4 py-2 mt-2">Xem Danh Sách Sân</a>
    </div>
}
