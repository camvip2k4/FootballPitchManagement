@model FootballPitchManagement.Models.ViewModels.LoginVM

@{
    ViewData["Title"] = "Sign In";
}

<div class="row justify-content-center">
    <div class="col-md-5">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-primary text-white text-center py-3">
                <h4 class="mb-0"><i class="bi bi-box-arrow-in-right"></i> Sign In to FFMS</h4>
            </div>
            <div class="card-body p-4">
                <form asp-action="Login" method="post">
                    <input type="hidden" asp-for="ReturnUrl" />
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Username" class="form-label">Username</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-person"></i></span>
                            <input asp-for="Username" class="form-control" placeholder="Enter username" />
                        </div>
                        <span asp-validation-for="Username" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label">Password</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-key"></i></span>
                            <input asp-for="Password" class="form-control" placeholder="Enter password" />
                        </div>
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>

                    <div class="d-grid gap-2 mb-3">
                        <button type="submit" class="btn btn-primary py-2 fw-semibold">Login</button>
                    </div>

                    <div class="text-center">
                        Don't have an account? <a asp-action="Register">Register here</a>
                    </div>
                </form>

                <hr class="my-4" />

                <!-- 1-Click Demo Login Panel -->
                <div class="text-center">
                    <p class="text-muted small fw-bold mb-2">⚡ QUICK DEMO LOGIN (TEST ACCOUNTS):</p>
                    <div class="d-flex flex-wrap gap-2 justify-content-center">
                        <form asp-action="DemoLogin" method="post" class="d-inline">
                            <input type="hidden" name="role" value="CUSTOMER" />
                            <button type="submit" class="btn btn-outline-success btn-sm">
                                <i class="bi bi-person"></i> Customer
                            </button>
                        </form>
                        <form asp-action="DemoLogin" method="post" class="d-inline">
                            <input type="hidden" name="role" value="STAFF" />
                            <button type="submit" class="btn btn-outline-warning btn-sm text-dark">
                                <i class="bi bi-badge-ad"></i> Staff (Front Desk)
                            </button>
                        </form>
                        <form asp-action="DemoLogin" method="post" class="d-inline">
                            <input type="hidden" name="role" value="MANAGER" />
                            <button type="submit" class="btn btn-outline-info btn-sm text-dark">
                                <i class="bi bi-briefcase"></i> Manager
                            </button>
                        </form>
                        <form asp-action="DemoLogin" method="post" class="d-inline">
                            <input type="hidden" name="role" value="ADMIN" />
                            <button type="submit" class="btn btn-outline-danger btn-sm">
                                <i class="bi bi-shield-lock"></i> Admin
                            </button>
                        </form>
                    </div>
                    <small class="text-muted d-block mt-2">(Default password for all accounts: <code>123456</code>)</small>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

