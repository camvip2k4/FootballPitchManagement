@model FootballPitchManagement.Models.ViewModels.RegisterVM

@{
    ViewData["Title"] = "Đăng Ký Tài Khoản Khách Hàng";
}

<div class="row justify-content-center">
    <div class="col-lg-6 col-md-8">
        <div class="card shadow border-0 rounded-4 overflow-hidden">
            <div class="card-header bg-dark text-white text-center py-4">
                <i class="bi bi-person-plus-fill text-success display-4"></i>
                <h4 class="mb-0 fw-bold mt-2">Đăng Ký Thành Viên SPORT ARENA</h4>
                <small class="text-muted">Nhận ưu đãi đặt sân và quản lý lịch thi đấu thuận tiện</small>
            </div>
            <div class="card-body p-4 p-md-5">
                <form asp-action="Register" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="FullName" class="form-label fw-bold">Họ và tên</label>
                        <input asp-for="FullName" class="form-control" placeholder="Ví dụ: Nguyễn Văn An" />
                        <span asp-validation-for="FullName" class="text-danger"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Username" class="form-label fw-bold">Tên đăng nhập</label>
                            <input asp-for="Username" class="form-control" placeholder="username" />
                            <span asp-validation-for="Username" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Phone" class="form-label fw-bold">Số điện thoại</label>
                            <input asp-for="Phone" class="form-control" placeholder="0987654321" />
                            <span asp-validation-for="Phone" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-bold">Địa chỉ Email</label>
                        <input asp-for="Email" class="form-control" placeholder="email@gmail.com" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Password" class="form-label fw-bold">Mật khẩu</label>
                            <input asp-for="Password" class="form-control" placeholder="Tối thiểu 6 ký tự" />
                            <span asp-validation-for="Password" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-4">
                            <label asp-for="ConfirmPassword" class="form-label fw-bold">Xác nhận mật khẩu</label>
                            <input asp-for="ConfirmPassword" class="form-control" placeholder="Nhập lại mật khẩu" />
                            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="d-grid gap-2 mb-3">
                        <button type="submit" class="btn btn-success btn-lg fw-bold py-3 shadow-sm">
                            <i class="bi bi-person-check-fill me-1"></i> Hoàn Tất Đăng Ký
                        </button>
                    </div>

                    <div class="text-center text-secondary small">
                        Đã có tài khoản? <a asp-action="Login" class="text-primary fw-bold text-decoration-none">Đăng nhập tại đây</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
