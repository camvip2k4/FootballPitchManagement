@model IEnumerable<FootballPitchManagement.Models.Entities.Account>

@{
    ViewData["Title"] = "Quản Trị Người Dùng & Phân Quyền";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-people text-info"></i> Quản Trị Người Dùng & Phân Quyền</h2>
        <p class="text-muted mb-0">Quản lý danh sách thành viên, cập nhật vai trò (Khách hàng, Lễ tân, Quản lý, Admin) và trạng thái kích hoạt tài khoản</p>
    </div>
</div>

<div class="table-responsive bg-white rounded shadow-sm p-3">
    <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
            <tr>
                <th>Mã TK</th>
                <th>Tên đăng nhập</th>
                <th>Họ và tên</th>
                <th>Email</th>
                <th>Số điện thoại</th>
                <th>Vai trò</th>
                <th>Trạng thái</th>
                <th class="text-center">Thao tác quản trị</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var a in Model)
            {
                <tr>
                    <td class="fw-bold text-muted">#@a.AccountId</td>
                    <td class="fw-bold text-primary">@a.Username</td>
                    <td>@a.FullName</td>
                    <td><small class="text-muted">@a.Email</small></td>
                    <td><small class="text-muted">@a.Phone</small></td>
                    <td>
                        <form asp-action="UpdateRole" method="post" class="d-inline">
                            <input type="hidden" name="id" value="@a.AccountId" />
                            <select name="role" class="form-select form-select-sm d-inline-block w-auto" onchange="this.form.submit()">
                                <option value="CUSTOMER" selected="@(a.Role == FootballPitchManagement.Models.Enums.RoleType.CUSTOMER)">Khách hàng</option>
                                <option value="STAFF" selected="@(a.Role == FootballPitchManagement.Models.Enums.RoleType.STAFF)">Nhân viên Lễ tân</option>
                                <option value="MANAGER" selected="@(a.Role == FootballPitchManagement.Models.Enums.RoleType.MANAGER)">Quản lý cơ sở</option>
                                <option value="ADMIN" selected="@(a.Role == FootballPitchManagement.Models.Enums.RoleType.ADMIN)">Quản trị viên (Admin)</option>
                            </select>
                        </form>
                    </td>
                    <td>
                        <form asp-action="ToggleStatus" asp-route-id="@a.AccountId" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm @(a.Status == FootballPitchManagement.Models.Enums.AccountStatus.ACTIVE ? "btn-success" : "btn-danger")">
                                @(a.Status == FootballPitchManagement.Models.Enums.AccountStatus.ACTIVE ? "Đang hoạt động" : "Bị khóa")
                            </button>
                        </form>
                    </td>
                    <td class="text-center">
                        <form asp-action="ResetPassword" asp-route-id="@a.AccountId" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc muốn đặt lại mật khẩu cho tài khoản @a.Username về mặc định 123456?');">
                            <button type="submit" class="btn btn-outline-warning btn-sm text-dark">
                                <i class="bi bi-key me-1"></i> Đặt lại MK
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
