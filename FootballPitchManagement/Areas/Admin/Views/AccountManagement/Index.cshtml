@model IEnumerable<FootballPitchManagement.Models.Entities.Account>

@{
    ViewData["Title"] = "User Account Management";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-people text-info"></i> User Account Administration</h2>
        <p class="text-muted mb-0">Manage system users, role privileges (Customer, Staff, Manager, Admin), and account activation</p>
    </div>
</div>

<div class="table-responsive bg-white rounded shadow-sm p-3">
    <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
            <tr>
                <th>Account ID</th>
                <th>Username</th>
                <th>Full Name</th>
                <th>Email</th>
                <th>Phone</th>
                <th>Role</th>
                <th>Status</th>
                <th class="text-center">Administration Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var a in Model)
            {
                <tr>
                    <td>#@a.AccountId</td>
                    <td class="fw-bold text-primary">@a.Username</td>
                    <td>@a.FullName</td>
                    <td><small>@a.Email</small></td>
                    <td><small>@a.Phone</small></td>
                    <td>
                        <form asp-action="UpdateRole" method="post" class="d-inline">
                            <input type="hidden" name="id" value="@a.AccountId" />
                            <select name="role" class="form-select form-select-sm d-inline-block w-auto" onchange="this.form.submit()">
                                <option value="CUSTOMER" selected="@(a.Role == FootballPitchManagement.Models.Enums.RoleType.CUSTOMER)">CUSTOMER</option>
                                <option value="STAFF" selected="@(a.Role == FootballPitchManagement.Models.Enums.RoleType.STAFF)">STAFF</option>
                                <option value="MANAGER" selected="@(a.Role == FootballPitchManagement.Models.Enums.RoleType.MANAGER)">MANAGER</option>
                                <option value="ADMIN" selected="@(a.Role == FootballPitchManagement.Models.Enums.RoleType.ADMIN)">ADMIN</option>
                            </select>
                        </form>
                    </td>
                    <td>
                        <form asp-action="ToggleStatus" asp-route-id="@a.AccountId" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm @(a.Status == FootballPitchManagement.Models.Enums.AccountStatus.ACTIVE ? "btn-success" : "btn-danger")">
                                @a.Status
                            </button>
                        </form>
                    </td>
                    <td class="text-center">
                        <form asp-action="ResetPassword" asp-route-id="@a.AccountId" method="post" class="d-inline" onsubmit="return confirm('Reset password for @a.Username to 123456?');">
                            <button type="submit" class="btn btn-outline-warning btn-sm text-dark">
                                <i class="bi bi-key"></i> Reset Password
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

