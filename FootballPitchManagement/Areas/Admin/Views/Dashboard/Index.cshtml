@model FootballPitchManagement.Models.ViewModels.DashboardVM

@{
    ViewData["Title"] = "Manager & Admin Dashboard";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-speedometer2 text-primary"></i> Management & Reporting Dashboard</h2>
        <p class="text-muted mb-0">Overview of facility revenue, bookings, pitch utilization, and pending refunds</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-controller="FieldManagement" asp-action="Index" class="btn btn-outline-primary btn-sm fw-semibold">
            <i class="bi bi-grid-3x3"></i> Manage Pitches
        </a>
        <a asp-controller="PricingManagement" asp-action="Index" class="btn btn-outline-success btn-sm fw-semibold">
            <i class="bi bi-tags"></i> Pricing Rules
        </a>
        <a asp-controller="PolicyManagement" asp-action="Index" class="btn btn-outline-secondary btn-sm fw-semibold">
            <i class="bi bi-sliders"></i> Policies
        </a>
    </div>
</div>

<!-- Quick Stats Cards -->
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card bg-white border-0 shadow-sm p-3 border-start border-4 border-primary h-100">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-muted small fw-semibold text-uppercase">Total Pitches</span>
                    <h3 class="fw-bold text-dark mt-1 mb-0">@Model.TotalFields</h3>
                    <small class="text-success"><i class="bi bi-check-circle"></i> @Model.ActiveFields active</small>
                </div>
                <i class="bi bi-dribbble text-primary" style="font-size: 2.5rem;"></i>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card bg-white border-0 shadow-sm p-3 border-start border-4 border-success h-100">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-muted small fw-semibold text-uppercase">Today's Bookings</span>
                    <h3 class="fw-bold text-dark mt-1 mb-0">@Model.TodayBookings</h3>
                    <small class="text-muted">Matches scheduled</small>
                </div>
                <i class="bi bi-calendar2-check text-success" style="font-size: 2.5rem;"></i>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card bg-white border-0 shadow-sm p-3 border-start border-4 border-info h-100">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-muted small fw-semibold text-uppercase">Total Revenue</span>
                    <h3 class="fw-bold text-dark mt-1 mb-0">@Model.TotalRevenue.ToString("N0")</h3>
                    <small class="text-muted">VND collected</small>
                </div>
                <i class="bi bi-cash-coin text-info" style="font-size: 2.5rem;"></i>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card bg-white border-0 shadow-sm p-3 border-start border-4 border-danger h-100">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-muted small fw-semibold text-uppercase">Pending Refunds</span>
                    <h3 class="fw-bold text-danger mt-1 mb-0">@Model.PendingRefunds</h3>
                    <a asp-controller="Staff" asp-action="RefundQueue" class="small text-danger text-decoration-none">Review queue &rarr;</a>
                </div>
                <i class="bi bi-exclamation-octagon text-danger" style="font-size: 2.5rem;"></i>
            </div>
        </div>
    </div>
</div>

<!-- Navigation Shortcuts -->
<div class="card shadow-sm border-0 mb-4 bg-white">
    <div class="card-body p-3">
        <div class="row text-center g-2">
            <div class="col-md-2">
                <a asp-controller="FieldManagement" asp-action="Index" class="btn btn-light w-100 p-2 text-dark">
                    <i class="bi bi-grid-3x3 fs-4 d-block text-primary"></i> Pitches (UC24)
                </a>
            </div>
            <div class="col-md-2">
                <a asp-controller="PricingManagement" asp-action="Index" class="btn btn-light w-100 p-2 text-dark">
                    <i class="bi bi-cash-stack fs-4 d-block text-success"></i> Dynamic Pricing (UC26)
                </a>
            </div>
            <div class="col-md-2">
                <a asp-controller="PolicyManagement" asp-action="Index" class="btn btn-light w-100 p-2 text-dark">
                    <i class="bi bi-sliders fs-4 d-block text-warning"></i> Policies (UC36)
                </a>
            </div>
            <div class="col-md-3">
                <a asp-controller="FacilityCancel" asp-action="Index" class="btn btn-light w-100 p-2 text-dark">
                    <i class="bi bi-shield-slash fs-4 d-block text-danger"></i> Facility Cancellation (UC39)
                </a>
            </div>
            @if (User.IsInRole("Admin"))
            {
                <div class="col-md-3">
                    <a asp-controller="AccountManagement" asp-action="Index" class="btn btn-light w-100 p-2 text-dark">
                        <i class="bi bi-people fs-4 d-block text-info"></i> User Accounts
                    </a>
                </div>
            }
        </div>
    </div>
</div>

<!-- Recent Bookings Table -->
<div class="card shadow-sm border-0 mb-4">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
        <h5 class="fw-bold mb-0">Recent Bookings</h5>
        <a asp-controller="Staff" asp-action="Index" class="btn btn-sm btn-outline-primary">Open Front Desk Operations</a>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Code</th>
                        <th>Pitch</th>
                        <th>Slot / Date</th>
                        <th>Customer</th>
                        <th>Price</th>
                        <th>Paid</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.RecentBookings.Any())
                    {
                        @foreach (var b in Model.RecentBookings)
                        {
                            <tr>
                                <td class="fw-bold text-primary">@b.BookingCode</td>
                                <td>@b.Field?.Name</td>
                                <td>@b.BookingDate.ToString("dd/MM/yyyy") (@b.TimeSlot?.SlotName)</td>
                                <td>@(b.Account?.FullName ?? b.GuestName ?? "Guest")</td>
                                <td>@b.AgreedPrice.ToString("N0") VND</td>
                                <td class="text-success fw-bold">@b.PaidAmount.ToString("N0") VND</td>
                                <td>
                                    <span class="badge @(b.Status == FootballPitchManagement.Models.Enums.BookingStatus.CONFIRMED ? "bg-success" : (b.Status == FootballPitchManagement.Models.Enums.BookingStatus.CHECKED_IN ? "bg-info text-dark" : "bg-warning text-dark"))">
                                        @b.Status
                                    </span>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted">No recent bookings recorded.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
