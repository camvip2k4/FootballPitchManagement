@model FootballPitchManagement.Models.ViewModels.DashboardVM

@{
    ViewData["Title"] = "Trung Tâm Điều Hành & Báo Cáo";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1 text-dark"><i class="bi bi-speedometer2 text-primary"></i> Trung Tâm Điều Hành & Báo Cáo</h2>
        <p class="text-muted mb-0">Theo dõi doanh thu, tỷ lệ lấp đầy sân, các trận đấu hôm nay và các đơn hoàn tiền</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-controller="FieldManagement" asp-action="Index" class="btn btn-outline-primary btn-sm fw-semibold">
            <i class="bi bi-grid-3x3 me-1"></i> Danh Mục Sân
        </a>
        <a asp-controller="PricingManagement" asp-action="Index" class="btn btn-outline-success btn-sm fw-semibold">
            <i class="bi bi-tags me-1"></i> Bảng Giá Động
        </a>
        <a asp-controller="PolicyManagement" asp-action="Index" class="btn btn-outline-secondary btn-sm fw-semibold">
            <i class="bi bi-sliders me-1"></i> Chính Sách
        </a>
    </div>
</div>

<!-- Các thẻ thống kê doanh thu & tình trạng -->
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card bg-white border-0 shadow-sm p-3 border-start border-4 border-primary h-100 rounded-3">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-muted small fw-bold text-uppercase">Quy Mô Sân</span>
                    <h3 class="fw-bold text-dark mt-1 mb-0">@Model.TotalFields</h3>
                    <small class="text-success fw-semibold"><i class="bi bi-check-circle me-1"></i> @Model.ActiveFields sân đang hoạt động</small>
                </div>
                <i class="bi bi-dribbble text-primary" style="font-size: 2.5rem;"></i>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card bg-white border-0 shadow-sm p-3 border-start border-4 border-success h-100 rounded-3">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-muted small fw-bold text-uppercase">Lịch Đá Hôm Nay</span>
                    <h3 class="fw-bold text-dark mt-1 mb-0">@Model.TodayBookings</h3>
                    <small class="text-muted">Trận đấu đã lên lịch</small>
                </div>
                <i class="bi bi-calendar2-check text-success" style="font-size: 2.5rem;"></i>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card bg-white border-0 shadow-sm p-3 border-start border-4 border-info h-100 rounded-3">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-muted small fw-bold text-uppercase">Tổng Doanh Thu</span>
                    <h3 class="fw-bold text-dark mt-1 mb-0">@Model.TotalRevenue.ToString("N0")</h3>
                    <small class="text-muted">VND thực thu</small>
                </div>
                <i class="bi bi-cash-coin text-info" style="font-size: 2.5rem;"></i>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card bg-white border-0 shadow-sm p-3 border-start border-4 border-danger h-100 rounded-3">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-muted small fw-bold text-uppercase">Yêu Cầu Hoàn Tiền</span>
                    <h3 class="fw-bold text-danger mt-1 mb-0">@Model.PendingRefunds</h3>
                    <a asp-area="" asp-controller="Staff" asp-action="RefundQueue" class="small text-danger fw-bold text-decoration-none">Xem hàng đợi duyệt &rarr;</a>
                </div>
                <i class="bi bi-exclamation-octagon text-danger" style="font-size: 2.5rem;"></i>
            </div>
        </div>
    </div>
</div>

<!-- Lối tắt nhanh tới các chức năng quản lý -->
<div class="card shadow-sm border-0 mb-4 bg-white rounded-4">
    <div class="card-body p-3">
        <div class="row text-center g-2">
            <div class="col-md-2">
                <a asp-controller="FieldManagement" asp-action="Index" class="btn btn-light w-100 p-3 text-dark rounded-3">
                    <i class="bi bi-grid-3x3 fs-3 d-block text-primary mb-1"></i> Quản Lý Sân
                </a>
            </div>
            <div class="col-md-2">
                <a asp-controller="PricingManagement" asp-action="Index" class="btn btn-light w-100 p-3 text-dark rounded-3">
                    <i class="bi bi-tags-fill fs-3 d-block text-success mb-1"></i> Bảng Giá Động
                </a>
            </div>
            <div class="col-md-2">
                <a asp-controller="PolicyManagement" asp-action="Index" class="btn btn-light w-100 p-3 text-dark rounded-3">
                    <i class="bi bi-sliders fs-3 d-block text-warning mb-1"></i> Chính Sách
                </a>
            </div>
            <div class="col-md-3">
                <a asp-controller="FacilityCancel" asp-action="Index" class="btn btn-light w-100 p-3 text-dark rounded-3">
                    <i class="bi bi-cloud-lightning-rain-fill fs-3 d-block text-danger mb-1"></i> Hủy Do Sự Cố / Mưa
                </a>
            </div>
            @if (User.IsInRole("Admin"))
            {
                <div class="col-md-3">
                    <a asp-controller="AccountManagement" asp-action="Index" class="btn btn-light w-100 p-3 text-dark rounded-3">
                        <i class="bi bi-people-fill fs-3 d-block text-info mb-1"></i> Quản Trị Người Dùng
                    </a>
                </div>
            }
        </div>
    </div>
</div>

<!-- Đơn đặt sân mới nhất -->
<div class="card shadow-sm border-0 mb-4 rounded-4 overflow-hidden">
    <div class="card-header bg-white py-3 px-4 d-flex justify-content-between align-items-center border-0">
        <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-receipt text-primary me-2"></i> Đơn Đặt Sân Gần Đây</h5>
        <a asp-area="" asp-controller="Staff" asp-action="Index" class="btn btn-sm btn-outline-primary">Mở Bàn Điều Độ Lễ Tân</a>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Mã Đơn</th>
                        <th>Sân Bóng</th>
                        <th>Ca Đá / Ngày</th>
                        <th>Khách Hàng</th>
                        <th>Tổng Giá</th>
                        <th>Đã Thu</th>
                        <th>Trạng Thái</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.RecentBookings.Any())
                    {
                        @foreach (var b in Model.RecentBookings)
                        {
                            <tr>
                                <td class="fw-bold text-primary">@b.BookingCode</td>
                                <td class="fw-semibold">@b.Field?.Name</td>
                                <td>@b.BookingDate.ToString("dd/MM/yyyy") (@b.TimeSlot?.SlotName)</td>
                                <td>@(b.Account?.FullName ?? b.GuestName ?? "Khách vãng lai")</td>
                                <td>@b.AgreedPrice.ToString("N0") đ</td>
                                <td class="text-success fw-bold">@b.PaidAmount.ToString("N0") đ</td>
                                <td>
                                    @{
                                        (string badge, string text) = b.Status switch
                                        {
                                            FootballPitchManagement.Models.Enums.BookingStatus.CONFIRMED => ("bg-success", "Đã xác nhận"),
                                            FootballPitchManagement.Models.Enums.BookingStatus.CHECKED_IN => ("bg-info text-dark", "Đang thi đấu"),
                                            FootballPitchManagement.Models.Enums.BookingStatus.PENDING_PAYMENT => ("bg-warning text-dark", "Chờ đặt cọc"),
                                            FootballPitchManagement.Models.Enums.BookingStatus.COMPLETED => ("bg-primary", "Đã hoàn thành"),
                                            FootballPitchManagement.Models.Enums.BookingStatus.CANCELLED => ("bg-secondary", "Đã hủy"),
                                            _ => ("bg-secondary", b.Status.ToString())
                                        };
                                    }
                                    <span class="badge @badge">@text</span>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted">Chưa có giao dịch đặt sân nào được ghi nhận.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
