@model IEnumerable<FootballPitchManagement.Models.Entities.FootballField>

@{
    ViewData["Title"] = "Quản Lý Danh Sách Sân Bóng";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-grid-3x3 text-primary"></i> Quản Lý Danh Sách Sân Bóng</h2>
        <p class="text-muted mb-0">Thêm, sửa, đóng/mở nhận đặt sân và chuyển đổi trạng thái vận hành (Sẵn sàng / Bảo trì)</p>
    </div>
    <div>
        <a asp-action="Create" class="btn btn-primary fw-semibold shadow-sm">
            <i class="bi bi-plus-circle me-1"></i> Thêm Sân Mới
        </a>
    </div>
</div>

<div class="table-responsive bg-white rounded shadow-sm p-3">
    <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
            <tr>
                <th>Mã sân</th>
                <th>Tên sân</th>
                <th>Quy chuẩn sân</th>
                <th>Khu vực / Vị trí</th>
                <th>Giờ mở cửa</th>
                <th>Kích hoạt nhận đặt</th>
                <th>Trạng thái thực tế</th>
                <th class="text-center">Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                @foreach (var f in Model)
                {
                    <tr>
                        <td class="fw-bold text-muted">#@f.FieldId</td>
                        <td class="fw-bold text-primary">@f.Name</td>
                        <td>
                            @switch (f.FieldType)
                            {
                                case FootballPitchManagement.Models.Enums.FieldType.FIELD_5:
                                    <span class="badge bg-secondary">Sân 5 người</span>
                                    break;
                                case FootballPitchManagement.Models.Enums.FieldType.FIELD_7:
                                    <span class="badge bg-info text-dark">Sân 7 người</span>
                                    break;
                                case FootballPitchManagement.Models.Enums.FieldType.FIELD_11:
                                    <span class="badge bg-success">Sân 11 người</span>
                                    break;
                            }
                        </td>
                        <td><small class="text-muted">@f.Location</small></td>
                        <td><small class="fw-semibold">@f.OpenTime.ToString(@"hh\:mm") - @f.CloseTime.ToString(@"hh\:mm")</small></td>
                        <td>
                            <form asp-action="ToggleActivation" asp-route-id="@f.FieldId" method="post" class="d-inline">
                                <button type="submit" class="btn btn-sm @(f.IsActive ? "btn-success" : "btn-outline-danger")">
                                    @(f.IsActive ? "Đang nhận khách" : "Ngừng nhận khách")
                                </button>
                            </form>
                        </td>
                        <td>
                            <div class="dropdown d-inline">
                                <button class="btn btn-sm dropdown-toggle @(f.Status == FootballPitchManagement.Models.Enums.FieldStatus.AVAILABLE ? "btn-outline-success" : (f.Status == FootballPitchManagement.Models.Enums.FieldStatus.OCCUPIED ? "btn-info text-dark" : "btn-danger"))" type="button" data-bs-toggle="dropdown">
                                    @(f.Status == FootballPitchManagement.Models.Enums.FieldStatus.AVAILABLE ? "Sẵn sàng (Hoạt động)" : (f.Status == FootballPitchManagement.Models.Enums.FieldStatus.OCCUPIED ? "Đang có trận đấu" : "Đang bảo trì cỏ/đèn"))
                                </button>
                                <ul class="dropdown-menu">
                                    <li>
                                        <form asp-action="UpdateOperationalStatus" asp-route-id="@f.FieldId" asp-route-status="AVAILABLE" method="post">
                                            <button type="submit" class="dropdown-item text-success"><i class="bi bi-check-circle me-1"></i> Chuyển sang SẴN SÀNG</button>
                                        </form>
                                    </li>
                                    <li>
                                        <form asp-action="UpdateOperationalStatus" asp-route-id="@f.FieldId" asp-route-status="MAINTENANCE" method="post">
                                            <button type="submit" class="dropdown-item text-danger"><i class="bi bi-tools me-1"></i> Chuyển sang BẢO TRÌ</button>
                                        </form>
                                    </li>
                                </ul>
                            </div>
                        </td>
                        <td class="text-center">
                            <a asp-action="Edit" asp-route-id="@f.FieldId" class="btn btn-outline-primary btn-sm me-1">
                                <i class="bi bi-pencil"></i> Chỉnh sửa
                            </a>
                            <a asp-controller="PricingManagement" asp-action="Index" asp-route-fieldId="@f.FieldId" class="btn btn-outline-success btn-sm">
                                <i class="bi bi-tags"></i> Bảng giá
                            </a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="8" class="text-center py-4 text-muted">Chưa có sân bóng nào trong hệ thống.</td>
                </tr>
            }
        </tbody>
    </table>
</div>
