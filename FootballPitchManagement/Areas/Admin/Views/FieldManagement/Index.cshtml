@model IEnumerable<FootballPitchManagement.Models.Entities.FootballField>

@{
    ViewData["Title"] = "Manage Football Pitches (UC24)";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-grid-3x3 text-primary"></i> Football Pitches Management (UC24)</h2>
        <p class="text-muted mb-0">Add, edit, deactivate fields, or override operational status (Available / Maintenance)</p>
    </div>
    <div>
        <a asp-action="Create" class="btn btn-primary fw-semibold">
            <i class="bi bi-plus-circle"></i> Add New Field
        </a>
    </div>
</div>

<div class="table-responsive bg-white rounded shadow-sm p-3">
    <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
            <tr>
                <th>ID</th>
                <th>Pitch Name</th>
                <th>Type</th>
                <th>Location</th>
                <th>Operating Hours</th>
                <th>Activation Flag</th>
                <th>Operational Status</th>
                <th class="text-center">Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                @foreach (var f in Model)
                {
                    <tr>
                        <td>#@f.FieldId</td>
                        <td class="fw-bold text-primary">@f.Name</td>
                        <td><span class="badge bg-secondary">@f.FieldType</span></td>
                        <td><small>@f.Location</small></td>
                        <td><small>@f.OpenTime.ToString(@"hh\:mm") - @f.CloseTime.ToString(@"hh\:mm")</small></td>
                        <td>
                            <form asp-action="ToggleActivation" asp-route-id="@f.FieldId" method="post" class="d-inline">
                                <button type="submit" class="btn btn-sm @(f.IsActive ? "btn-success" : "btn-outline-danger")">
                                    @(f.IsActive ? "Active (Bookable)" : "Deactivated")
                                </button>
                            </form>
                        </td>
                        <td>
                            <div class="dropdown d-inline">
                                <button class="btn btn-sm dropdown-toggle @(f.Status == FootballPitchManagement.Models.Enums.FieldStatus.AVAILABLE ? "btn-outline-success" : (f.Status == FootballPitchManagement.Models.Enums.FieldStatus.OCCUPIED ? "btn-info text-dark" : "btn-danger"))" type="button" data-bs-toggle="dropdown">
                                    @f.Status
                                </button>
                                <ul class="dropdown-menu">
                                    <li>
                                        <form asp-action="UpdateOperationalStatus" asp-route-id="@f.FieldId" asp-route-status="AVAILABLE" method="post">
                                            <button type="submit" class="dropdown-item text-success"><i class="bi bi-check-circle"></i> Set AVAILABLE</button>
                                        </form>
                                    </li>
                                    <li>
                                        <form asp-action="UpdateOperationalStatus" asp-route-id="@f.FieldId" asp-route-status="MAINTENANCE" method="post">
                                            <button type="submit" class="dropdown-item text-danger"><i class="bi bi-tools"></i> Set MAINTENANCE</button>
                                        </form>
                                    </li>
                                </ul>
                            </div>
                        </td>
                        <td class="text-center">
                            <a asp-action="Edit" asp-route-id="@f.FieldId" class="btn btn-outline-primary btn-sm me-1">
                                <i class="bi bi-pencil"></i> Edit
                            </a>
                            <a asp-controller="PricingManagement" asp-action="Index" asp-route-fieldId="@f.FieldId" class="btn btn-outline-success btn-sm">
                                <i class="bi bi-tags"></i> Pricing
                            </a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="8" class="text-center py-4 text-muted">No fields created yet.</td>
                </tr>
            }
        </tbody>
    </table>
</div>

