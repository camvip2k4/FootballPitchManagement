@model FootballPitchManagement.Models.Entities.FootballField

@{
    ViewData["Title"] = "Thêm Sân Bóng Mới";
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-primary text-white py-3">
                <h4 class="mb-0"><i class="bi bi-plus-circle me-1"></i> Thêm Sân Bóng Mới Vào Hệ Thống</h4>
            </div>
            <div class="card-body p-4">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label fw-bold">Tên Sân Bóng</label>
                        <input asp-for="Name" class="form-control" placeholder="Ví dụ: Sân 5A - Sân Cỏ Nhân Tạo Chuẩn FIFA" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="FieldType" class="form-label fw-bold">Quy chuẩn kích thước</label>
                            <select asp-for="FieldType" class="form-select">
                                <option value="FIELD_5">Sân 5 người (Mini)</option>
                                <option value="FIELD_7">Sân 7 người (Trung bình)</option>
                                <option value="FIELD_11">Sân 11 người (Tiêu chuẩn)</option>
                            </select>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Location" class="form-label fw-bold">Khu vực / Cổng vào</label>
                            <input asp-for="Location" class="form-control" placeholder="Ví dụ: Khu A - Cổng Bắc" />
                            <span asp-validation-for="Location" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="OpenTime" class="form-label fw-bold">Giờ mở cửa</label>
                            <input asp-for="OpenTime" class="form-control" type="time" value="06:00" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="CloseTime" class="form-label fw-bold">Giờ đóng cửa</label>
                            <input asp-for="CloseTime" class="form-control" type="time" value="23:00" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label fw-bold">Mô tả đặc điểm / Tiện ích sân</label>
                        <textarea asp-for="Description" class="form-control" rows="3" placeholder="Chất lượng mặt cỏ Ý, hệ thống đèn chiếu sáng LED chống lóa, lưới chắn bóng..."></textarea>
                    </div>

                    <div class="form-check mb-4">
                        <input asp-for="IsActive" class="form-check-input" type="checkbox" checked />
                        <label asp-for="IsActive" class="form-check-label fw-semibold">Kích hoạt nhận đặt sân ngay lập tức (Hiển thị cho khách hàng đặt trực tuyến)</label>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary btn-lg fw-semibold py-2">
                            <i class="bi bi-save me-1"></i> Lưu Thông Tin Sân
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Quay lại danh sách</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
