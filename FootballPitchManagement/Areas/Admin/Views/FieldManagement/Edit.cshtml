@model FootballPitchManagement.Models.Entities.FootballField

@{
    ViewData["Title"] = "Chỉnh Sửa Sân Bóng";
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-primary text-white py-3">
                <h4 class="mb-0"><i class="bi bi-pencil-square me-1"></i> Chỉnh Sửa Thông Tin Sân Bóng</h4>
            </div>
            <div class="card-body p-4">
                <form asp-action="Edit" method="post">
                    <input type="hidden" asp-for="FieldId" />
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label fw-bold">Tên Sân Bóng</label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="FieldType" class="form-label fw-bold">Quy chuẩn kích thước</label>
                            <select asp-for="FieldType" class="form-select">
                                <option value="FIELD_5">Sân 5 người (Mini)</option>
                                <option value="FIELD_7">Sân 7 người (Trung bình)</option>
                                <option value="FIELD_11">Sân 11 người (Tiêu chuẩn)</option>
                            </select>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Location" class="form-label fw-bold">Khu vực / Cổng vào</label>
                            <input asp-for="Location" class="form-control" />
                            <span asp-validation-for="Location" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="OpenTime" class="form-label fw-bold">Giờ mở cửa</label>
                            <input asp-for="OpenTime" class="form-control" type="time" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="CloseTime" class="form-label fw-bold">Giờ đóng cửa</label>
                            <input asp-for="CloseTime" class="form-control" type="time" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label fw-bold">Mô tả đặc điểm / Tiện ích sân</label>
                        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                    </div>

                    <div class="row mb-4">
                        <div class="col-md-6">
                            <label asp-for="Status" class="form-label fw-bold">Trạng thái vận hành thực tế</label>
                            <select asp-for="Status" class="form-select">
                                <option value="AVAILABLE">AVAILABLE (Sẵn sàng hoạt động)</option>
                                <option value="OCCUPIED">OCCUPIED (Đang có trận đấu)</option>
                                <option value="MAINTENANCE">MAINTENANCE (Đang bảo trì định kỳ)</option>
                            </select>
                        </div>
                        <div class="col-md-6 d-flex align-items-center mt-3">
                            <div class="form-check">
                                <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                                <label asp-for="IsActive" class="form-check-label fw-semibold">Cho phép khách đặt trực tuyến (Active)</label>
                            </div>
                        </div>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary btn-lg fw-semibold py-2">
                            <i class="bi bi-check2-circle me-1"></i> Lưu Thay Đổi
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Quay lại danh sách</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
