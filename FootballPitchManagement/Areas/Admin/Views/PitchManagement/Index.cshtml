@model IEnumerable<FootballPitchManagement.Models.Entities.Pitch>

@{
    ViewData["Title"] = "Manage Pitches";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Football Pitches Management</h2>
        <a asp-action="Create" class="btn btn-primary">Add New Pitch</a>
    </div>

    <table class="table table-bordered table-striped">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Name</th>
                <th>Type</th>
                <th>Rate (VND/h)</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                @foreach (var pitch in Model)
                {
                    <tr>
                        <td>@pitch.PitchId</td>
                        <td>@pitch.Name</td>
                        <td>@pitch.PitchType?.Name</td>
                        <td>@pitch.HourlyRate.ToString("N0")</td>
                        <td>
                            <span class="badge @(pitch.IsActive ? "bg-success" : "bg-danger")">
                                @(pitch.IsActive ? "Active" : "Inactive")
                            </span>
                        </td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@pitch.PitchId" class="btn btn-warning btn-sm">Edit</a>
                            <form asp-action="Delete" asp-route-id="@pitch.PitchId" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this pitch?');">
                                <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="6" class="text-center">No pitches found.</td>
                </tr>
            }
        </tbody>
    </table>
</div>

