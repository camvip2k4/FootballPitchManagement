@model IEnumerable<FootballPitchManagement.Models.Entities.PricingRule>

@{
    ViewData["Title"] = "Manage Pricing Rules (UC26)";
    int? selectedFieldId = ViewBag.SelectedFieldId as int?;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-tags text-success"></i> Dynamic Pricing Rules (UC26)</h2>
        <p class="text-muted mb-0">Configure rate rules by day type (Weekday/Weekend) and peak hours</p>
    </div>
    <div>
        <a asp-action="Create" asp-route-fieldId="@selectedFieldId" class="btn btn-success fw-semibold">
            <i class="bi bi-plus-circle"></i> Add Pricing Rule
        </a>
    </div>
</div>

<!-- Field Filter -->
<div class="card shadow-sm border-0 mb-4">
    <div class="card-body p-3">
        <form method="get" asp-action="Index" class="row g-3 align-items-center">
            <div class="col-auto">
                <label class="col-form-label fw-bold">Filter by Field:</label>
            </div>
            <div class="col-auto">
                <select name="fieldId" asp-items="ViewBag.Fields" class="form-select" onchange="this.form.submit()">
                    <option value="">-- All Fields --</option>
                </select>
            </div>
        </form>
    </div>
</div>

<div class="table-responsive bg-white rounded shadow-sm p-3">
    <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
            <tr>
                <th>Rule ID</th>
                <th>Field</th>
                <th>Specialized Slot</th>
                <th>Price (VND)</th>
                <th>Day Type</th>
                <th>Time Tier</th>
                <th>Priority</th>
                <th>Effective Range</th>
                <th class="text-center">Action</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                @foreach (var r in Model)
                {
                    <tr>
                        <td>#@r.RuleId</td>
                        <td class="fw-bold text-primary">@(r.Field?.Name ?? $"Field #{r.FieldId}")</td>
                        <td>@(r.Slot != null ? r.Slot.SlotName : "Applies to all slots in tier")</td>
                        <td class="fw-bold text-success fs-6">@r.Price.ToString("N0") VND</td>
                        <td>
                            <span class="badge @(r.DayType == FootballPitchManagement.Models.Enums.DayType.WEEKEND ? "bg-warning text-dark" : "bg-secondary")">
                                @r.DayType
                            </span>
                        </td>
                        <td>
                            <span class="badge @(r.TimeTier == FootballPitchManagement.Models.Enums.TimeTier.PEAK ? "bg-danger" : "bg-info text-dark")">
                                @r.TimeTier
                            </span>
                        </td>
                        <td><span class="badge bg-dark">Priority: @r.Priority</span></td>
                        <td><small>@r.EffectiveFrom.ToString("dd/MM/yyyy") - @r.EffectiveTo.ToString("dd/MM/yyyy")</small></td>
                        <td class="text-center">
                            <form asp-action="Delete" asp-route-id="@r.RuleId" method="post" class="d-inline" onsubmit="return confirm('Delete this pricing rule?');">
                                <button type="submit" class="btn btn-outline-danger btn-sm">
                                    <i class="bi bi-trash"></i> Delete
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="9" class="text-center py-4 text-muted">No pricing rules defined for the selection.</td>
                </tr>
            }
        </tbody>
    </table>
</div>

