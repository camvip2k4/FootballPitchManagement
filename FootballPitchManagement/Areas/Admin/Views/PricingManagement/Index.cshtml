@model IEnumerable<FootballPitchManagement.Models.Entities.PricingRule>

@{
    ViewData["Title"] = "Quản Lý Bảng Giá Linh Hoạt";
    int? selectedFieldId = ViewBag.SelectedFieldId as int?;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-tags text-success"></i> Quản Lý Bảng Giá Linh Hoạt</h2>
        <p class="text-muted mb-0">Thiết lập quy tắc giá theo ngày (Ngày thường / Cuối tuần) và khung giờ (Giờ tiêu chuẩn / Khung giờ vàng)</p>
    </div>
    <div>
        <a asp-action="Create" asp-route-fieldId="@selectedFieldId" class="btn btn-success fw-semibold shadow-sm">
            <i class="bi bi-plus-circle me-1"></i> Thêm Quy Tắc Giá
        </a>
    </div>
</div>

<!-- Lọc theo sân -->
<div class="card shadow-sm border-0 mb-4">
    <div class="card-body p-3">
        <form method="get" asp-action="Index" class="row g-3 align-items-center">
            <div class="col-auto">
                <label class="col-form-label fw-bold">Lọc theo sân bóng:</label>
            </div>
            <div class="col-auto">
                <select name="fieldId" asp-items="ViewBag.Fields" class="form-select" onchange="this.form.submit()">
                    <option value="">-- Tất cả các sân --</option>
                </select>
            </div>
        </form>
    </div>
</div>

<div class="table-responsive bg-white rounded shadow-sm p-3">
    <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
            <tr>
                <th>Mã quy tắc</th>
                <th>Tên sân</th>
                <th>Khung giờ áp dụng</th>
                <th>Mức giá / Giờ</th>
                <th>Phân loại ngày</th>
                <th>Khung giờ</th>
                <th>Độ ưu tiên</th>
                <th>Thời hạn hiệu lực</th>
                <th class="text-center">Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                @foreach (var r in Model)
                {
                    <tr>
                        <td class="fw-bold text-muted">#@r.RuleId</td>
                        <td class="fw-bold text-primary">@(r.Field?.Name ?? $"Sân #{r.FieldId}")</td>
                        <td>@(r.Slot != null ? r.Slot.SlotName : "Áp dụng toàn bộ khung giờ theo tier")</td>
                        <td class="fw-bold text-success fs-6">@r.Price.ToString("N0") VNĐ</td>
                        <td>
                            <span class="badge @(r.DayType == FootballPitchManagement.Models.Enums.DayType.WEEKEND ? "bg-warning text-dark" : "bg-secondary")">
                                @(r.DayType == FootballPitchManagement.Models.Enums.DayType.WEEKEND ? "Cuối tuần (T7, CN)" : (r.DayType == FootballPitchManagement.Models.Enums.DayType.HOLIDAY ? "Ngày lễ" : "Ngày thường (T2-T6)"))
                            </span>
                        </td>
                        <td>
                            <span class="badge @(r.TimeTier == FootballPitchManagement.Models.Enums.TimeTier.PEAK ? "bg-danger" : "bg-info text-dark")">
                                @(r.TimeTier == FootballPitchManagement.Models.Enums.TimeTier.PEAK ? "Giờ vàng (Peak >= 17:00)" : "Giờ tiêu chuẩn")
                            </span>
                        </td>
                        <td><span class="badge bg-dark">Mức @r.Priority</span></td>
                        <td><small class="text-muted">@r.EffectiveFrom.ToString("dd/MM/yyyy") - @r.EffectiveTo.ToString("dd/MM/yyyy")</small></td>
                        <td class="text-center">
                            <form asp-action="Delete" asp-route-id="@r.RuleId" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc chắn muốn xóa quy tắc giá này không?');">
                                <button type="submit" class="btn btn-outline-danger btn-sm">
                                    <i class="bi bi-trash me-1"></i> Xóa
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="9" class="text-center py-4 text-muted">Chưa có quy tắc giá nào được thiết lập.</td>
                </tr>
            }
        </tbody>
    </table>
</div>
