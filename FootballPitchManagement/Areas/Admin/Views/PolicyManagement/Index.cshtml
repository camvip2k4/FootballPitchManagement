@model IEnumerable<FootballPitchManagement.Models.Entities.BusinessPolicy>

@{
    ViewData["Title"] = "Cấu Hình Chính Sách Hoạt Động (POL-01 - POL-07)";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-sliders text-warning"></i> Cấu Hình Chính Sách Hoạt Động</h2>
        <p class="text-muted mb-0">Các tham số vận hành trung tâm (POL-01 đến POL-07) quy định tỷ lệ đặt cọc, thời gian giữ chỗ, hủy sân và giờ check-in</p>
    </div>
</div>

<div class="table-responsive bg-white rounded shadow-sm p-3">
    <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
            <tr>
                <th>Mã chính sách</th>
                <th>Tên tham số</th>
                <th>Ý nghĩa nghiệp vụ</th>
                <th>Giá trị hiện tại</th>
                <th>Đơn vị tính</th>
                <th>Cập nhật lần cuối</th>
                <th class="text-center" style="width: 250px;">Thay đổi giá trị</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var p in Model)
            {
                <tr>
                    <td><span class="badge bg-primary">@p.PolicyCode</span></td>
                    <td class="fw-bold text-dark">@p.ParamKey</td>
                    <td><small class="text-muted">@p.Description</small></td>
                    <td>
                        <span class="fs-5 fw-bold text-success">@p.ParamValue</span>
                    </td>
                    <td><small class="text-secondary fw-semibold">@p.Unit</small></td>
                    <td><small class="text-muted">@p.UpdatedAt.ToString("dd/MM/yyyy HH:mm")</small></td>
                    <td>
                        <form asp-action="Update" method="post" class="d-flex gap-2">
                            <input type="hidden" name="policyId" value="@p.PolicyId" />
                            <input type="text" name="paramValue" class="form-control form-control-sm text-center fw-bold" value="@p.ParamValue" style="width: 100px;" />
                            <button type="submit" class="btn btn-outline-primary btn-sm">
                                <i class="bi bi-check2"></i> Lưu
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
