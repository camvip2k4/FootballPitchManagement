@model IEnumerable<FootballPitchManagement.Models.Entities.BusinessPolicy>

@{
    ViewData["Title"] = "Business Policy Configuration (UC36)";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-sliders text-warning"></i> Business Policy Configuration (UC36)</h2>
        <p class="text-muted mb-0">Facility parameters (POL-01 to POL-07) governing slot holds, deposit %, cancellation cutoff, and arrival windows</p>
    </div>
</div>

<div class="table-responsive bg-white rounded shadow-sm p-3">
    <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
            <tr>
                <th>Policy Code</th>
                <th>Parameter Key</th>
                <th>Description</th>
                <th>Current Value</th>
                <th>Unit</th>
                <th>Last Updated (UTC)</th>
                <th class="text-center" style="width: 250px;">Update Value</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var p in Model)
            {
                <tr>
                    <td><span class="badge bg-primary">@p.PolicyCode</span></td>
                    <td class="fw-bold text-dark">@p.ParamKey</td>
                    <td><small class="text-muted">@p.Description</small></td>
                    <td>
                        <span class="fs-5 fw-bold text-success">@p.ParamValue</span>
                    </td>
                    <td><small class="text-secondary fw-semibold">@p.Unit</small></td>
                    <td><small class="text-muted">@p.UpdatedAt.ToString("yyyy-MM-dd HH:mm")</small></td>
                    <td>
                        <form asp-action="Update" method="post" class="d-flex gap-2">
                            <input type="hidden" name="policyId" value="@p.PolicyId" />
                            <input type="text" name="paramValue" class="form-control form-control-sm text-center fw-bold" value="@p.ParamValue" style="width: 100px;" />
                            <button type="submit" class="btn btn-outline-primary btn-sm">
                                Save
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

