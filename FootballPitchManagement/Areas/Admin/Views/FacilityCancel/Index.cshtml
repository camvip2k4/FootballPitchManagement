@model IEnumerable<FootballPitchManagement.Models.Entities.Booking>

@{
    ViewData["Title"] = "Facility Emergency Cancellation (UC39)";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-shield-slash text-danger"></i> Facility Cancellation (UC39)</h2>
        <p class="text-muted mb-0">Cancel bookings due to facility maintenance, weather, or emergencies. 100% automatic refund will be issued.</p>
    </div>
</div>

<div class="alert alert-danger d-flex align-items-center mb-4">
    <i class="bi bi-exclamation-octagon-fill fs-3 me-3"></i>
    <div>
        <strong>Manager Facility Cancellation Policy:</strong>
        <p class="mb-0 small">
            Facility cancellation bypasses customer cutoff rules and automatically queues a <strong>100% refund</strong> for all paid amounts. An in-app notification is sent to the customer immediately.
        </p>
    </div>
</div>

<div class="table-responsive bg-white rounded shadow-sm p-3">
    <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
            <tr>
                <th>Booking Code</th>
                <th>Pitch</th>
                <th>Slot / Date</th>
                <th>Customer</th>
                <th>Paid Amount</th>
                <th>Status</th>
                <th style="min-width: 320px;">Facility Cancellation Reason & Action</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                @foreach (var b in Model)
                {
                    <tr>
                        <td class="fw-bold text-primary">@b.BookingCode</td>
                        <td>@b.Field?.Name</td>
                        <td>
                            <div>@b.BookingDate.ToString("dd/MM/yyyy")</div>
                            <small class="text-muted">@b.TimeSlot?.SlotName</small>
                        </td>
                        <td>
                            <div>@(b.Account?.FullName ?? b.GuestName ?? "Guest")</div>
                            <small class="text-muted">@(b.Account?.Phone ?? b.GuestPhone)</small>
                        </td>
                        <td class="text-success fw-bold">@b.PaidAmount.ToString("N0") VND</td>
                        <td>
                            <span class="badge @(b.Status == FootballPitchManagement.Models.Enums.BookingStatus.CONFIRMED ? "bg-success" : "bg-warning text-dark")">
                                @b.Status
                            </span>
                        </td>
                        <td>
                            <form asp-action="Cancel" method="post" class="d-flex gap-2" onsubmit="return confirm('Are you sure you want to cancel this booking for facility reasons? 100% refund will be queued.');">
                                <input type="hidden" name="bookingId" value="@b.BookingId" />
                                <input type="text" name="reason" class="form-control form-control-sm" placeholder="e.g. Heavy storm, lightning, flood, broken turf..." required />
                                <button type="submit" class="btn btn-danger btn-sm text-nowrap">
                                    <i class="bi bi-x-circle"></i> Cancel
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="7" class="text-center py-4 text-muted">No active bookings eligible for facility cancellation.</td>
                </tr>
            }
        </tbody>
    </table>
</div>

